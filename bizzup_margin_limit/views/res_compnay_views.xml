<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherited res company for add 2 new fields -->
    <record id="res_company_view_form_bpac" model="ir.ui.view">
        <field name="name">res.company.view.form.inherit.bpac</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='color']" position="after">
                 <field name="limit_parameter"/>
                 <field name="error_parameter"/>
             </xpath>
        </field>
    </record>
</odoo>


