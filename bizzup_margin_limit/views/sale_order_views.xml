<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherited res company for add 2 new fields -->
    <record id="sale_order_view_form_inherit_margin" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.margin</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="parent_id" string="Manager" domain="[('company_id', 'in', allowed_company_ids)]" readonly="1"/>
                    <field name="manager_approval" readonly="1"/>
                    <field name="email_sent_manager" readonly="1"/>
             </xpath>
        </field>
    </record>
</odoo>


