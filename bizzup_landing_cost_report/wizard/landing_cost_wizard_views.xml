<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_landing_cost_wizard_form" model="ir.ui.view">
        <field name="name">landing.cost.wizard.form</field>
        <field name="model">landing.cost.wizard</field>
        <field name="arch" type="xml">
            <form string="Landing Cost Report">
                <group>
                    <group>
                        <field name="date_from" required="1"/>
                        <field name="import_case_id" required="1"/>
                    </group>
                    <group>
                        <field name="date_to" required="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="generate_report" string="Generate" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="landing_cost_wizard_action" model="ir.actions.act_window">
        <field name="name">Landing Cost Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">landing.cost.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_landing_cost_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem
            name="Landing Cost Report"
            id="menu_landing_cost_report"
            parent="project.menu_project_report"
            action="landing_cost_wizard_action"
            sequence="11"/>
</odoo>