<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <record id="delivery_wa_template" model="wa.template">
            <field name="name">delivery_template</field>
            <field name="provider_id" ref="tus_meta_whatsapp_base.provider_1" />
            <field name="model_id" ref="stock.model_stock_picking" />
            <field name="category">utility</field>
            <field name="template_type">template</field>
            <field name="language">en</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <div style="margin: 0px; padding: 0px;">
                        <p style="margin: 0px; padding: 0px; font-size: 13px;">
                            Dear <t
                                t-out="object.sudo().partner_id.name or 'Madam/Sir'"
                                contenteditable="false"
                                data-oe-t-inline="true"
                            >Madam/Sir</t>,
                            <br />
                            <br />
                            We are glad to inform you that your order has been shipped.
                            <br />
                            <br />
                            Thank You.
                        </p>
                    </div>
                </div>
            </field>
        </record>

        <record id="delivery_wa_template_body" model="components">
            <field name="type">body</field>
            <field name="formate">text</field>
            <field
                name="wa_template_id"
                ref="tus_meta_wa_stock_picking.delivery_wa_template"
            />
            <field name="text">Dear {{1}},

We are glad to inform you that your order has been shipped.

Thank You.</field>
        </record>
    </data>
</odoo>
