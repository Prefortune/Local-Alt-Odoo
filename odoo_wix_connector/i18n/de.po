#. module: odoo_wix_connector
#: model_terms:ir.ui.view,arch_db:odoo_wix_connector.inherited_multi_channel_sale_wix
msgid ""
"<span class=\"text-muted\" invisible=\"channel != 'wix'\">\n"
"\t\t\t\t\t\t<br/>\n"
"\t\t\t\t\t\t<b>NOTE:</b> The Channel Order State is the comma seperated combination of Wix orders payment status and delivery status(eg: <strong>PAYMENT_STATE,DELIVERY_STATE</strong>).\n"
"\t\t\t\t\t\t<br/> Aailable PAYMENT_STATE: (PAID, NOT_PAID, PENDING, PARTIALLY_PAID, PARTIALLY_REFUNDED, FULLY_REFUNDED, UNSPECIFIED_PAYMENT_STATUS)\n"
"\t\t\t\t\t\t<br/> Available DELIVERY_STATE: (NOT_FULFILLED, FULFILLED, CANCELED, PARTIALLY_FULFILLED)\n"
"\t\t\t\t\t\t<br/> Examples: <strong>PAID,FULFILLED or NOT_PAID,NOT_FULFILLED or NOT_PAID,CANCELED or ...etc</strong>\n"
"\t\t\t\t\t\t<br/>(NOTE: Do not use space anywhere in this combination)\n"
"\t\t\t\t\t</span>"
msgstr ""
"<span class=\"text-muted\" unsichtbar=\"channel != 'wix'\">\n"
"\t\t\t\t\t\t<br/>\n"
"\t\t\t\t\t\t<b>HINWEIS:</b> Der Channel-Bestellstatus ist die durch Kommas getrennte Kombination aus dem Zahlungsstatus und dem Lieferstatus von Wix-Bestellungen (z. B. <strong>PAYMENT_STATE,DELIVERY_STATE</) stark>).\n"
"\t\t\t\t\t\t<br/> Verfügbarer PAYMENT_STATE: (BEZAHLT, NICHT_BEZAHLT, AUSSTEHEND, PARTIALLY_PAID, PARTIALLY_REFUNDED, FULLY_REFUNDED, UNSPECIFIED_PAYMENT_STATUS)\n"
"\t\t\t\t\t\t<br/> Verfügbar DELIVERY_STATE: (NOT_FULFILLED, FULFILLED, CANCELED, PARTIALLY_FULFILLED)\n"
"\t\t\t\t\t\t<br/> Beispiele: <strong>BEZAHLT, ERFÜLLT oder NICHT_BEZAHLT, NOT_FULFILLED oder NICHT_BEZAHLT, ABGESAGT oder ... usw.</strong>\n"
"\t\t\t\t\t\t<br/>(HINWEIS: Verwenden Sie in dieser Kombination nirgendwo Leerzeichen)\n"
"\t\t\t\t\t</span>"

#. module: odoo_wix_connector
#: model:ir.model.fields,help:odoo_wix_connector.field_import_wix_categories__update_customer_date
