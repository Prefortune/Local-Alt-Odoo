#. module: odoo_wix_connector
#: model_terms:ir.ui.view,arch_db:odoo_wix_connector.inherited_multi_channel_sale_wix
msgid ""
"<span class=\"text-muted\" invisible=\"channel != 'wix'\">\n"
"\t\t\t\t\t\t<br/>\n"
"\t\t\t\t\t\t<b>NOTE:</b> The Channel Order State is the comma seperated combination of Wix orders payment status and delivery status(eg: <strong>PAYMENT_STATE,DELIVERY_STATE</strong>).\n"
"\t\t\t\t\t\t<br/> Aailable PAYMENT_STATE: (PAID, NOT_PAID, PENDING, PARTIALLY_PAID, PARTIALLY_REFUNDED, FULLY_REFUNDED, UNSPECIFIED_PAYMENT_STATUS)\n"
"\t\t\t\t\t\t<br/> Available DELIVERY_STATE: (NOT_FULFILLED, FULFILLED, CANCELED, PARTIALLY_FULFILLED)\n"
"\t\t\t\t\t\t<br/> Examples: <strong>PAID,FULFILLED or NOT_PAID,NOT_FULFILLED or NOT_PAID,CANCELED or ...etc</strong>\n"
"\t\t\t\t\t\t<br/>(NOTE: Do not use space anywhere in this combination)\n"
"\t\t\t\t\t</span>"
msgstr ""
"\t\t\t\t\t\t<br/>\n"
"\t\t\t\t\t\t<b>ملاحظة:</b> حالة طلب القناة هي مجموعة مفصولة بفواصل بين حالة دفع طلبات Wix وحالة التسليم (على سبيل المثال: <strong>PAYMENT_STATE,DELIVERY_STATE</ قوي>).\n"
"\t\t\t\t\t\t<br/> PAYMENT_STATE المتاحة: (PAID، NOT_PAID، PENDING، PARTIALLY_PAID، PARTIALLY_REFUNDED، FULLY_REFUNDED، UNSPECIFIED_PAYMENT_STATUS)\n"
"\t\t\t\t\t\t<br/> DELIVERY_STATE المتوفرة: (NOT_FULFILLED، fulfiled، CANCELED، PARTIALLY_FULFILLED)\n"
"\t\t\t\t\t\t<br/> أمثلة: <strong>مدفوعة، أو مستوفاة أو غير مدفوعة، أو غير مستوفاة أو غير مدفوعة، أو ملغاة، أو ...إلخ</strong>\n"
"\t\t\t\t\t\t<br/>(ملاحظة: لا تستخدم المساحة في أي مكان في هذه المجموعة)\n"
"\t\t\t\t\t</span>"

