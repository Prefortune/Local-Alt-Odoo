<odoo>
    <data>
        <record id="multi_channel_view_kanban_wix" model="ir.ui.view">
            <field name="name">multi.channel.sale.kanban.wix</field>
            <field name="model">multi.channel.sale</field>
            <field name="inherit_id" ref="odoo_multi_channel_sale.multi_channel_view_kanban" />
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('wk_o_project_kanban_main')]//div[hasclass('o_kanban_card_content', 'o_visible', 'oe_kanban_global_click')]" position="inside">
                    <div class="o_kanban_primary_left">
                        <!-- <div class="o_primary">
                            <center>
                                <span>
                                    <t t-esc="record.name.value"/>
                                </span>
                            </center>
                        </div> -->
                        <div t-if="record.channel.value == 'Wix'" style="color:rgb(162, 70, 137);">
                            <center style="position:relative;margin-left:50px; margin-bottom: 28px;">
                                <img alt="wix icon" src="/odoo_wix_connector/static/description/thumbnail.png" height="160" width="160" />
                                <h3 style="position: relative;">
                                    <t t-esc="record.name.value" />
                                </h3>
                            </center>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
