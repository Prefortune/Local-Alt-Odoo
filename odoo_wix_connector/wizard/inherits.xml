<odoo>
    <record id="wix_inherit_export_odoo_templates_form" model="ir.ui.view">
        <field name="name">wix.inherit.export.template.form</field>
        <field name="model">export.templates</field>
        <field name="inherit_id" ref="odoo_multi_channel_sale.export_odoo_templates_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='cancel']" position="before">
                <button class="oe_highlight btn btn-success" name="export_button" string="Synchronize" invisible = "channel != 'wix'" type="object" />
            </xpath>
        </field>
    </record>

    <record id="wix_inherit_export_odoo_categories_form" model="ir.ui.view">
        <field name="name">wix.inherit.export.template.form</field>
        <field name="model">export.categories</field>
        <field name="inherit_id" ref="odoo_multi_channel_sale.export_odoo_categories_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='cancel']" position="before">
                <button class="oe_highlight btn btn-success" name="export_button" string="Synchronize" invisible = "channel != 'wix'" type="object" />
            </xpath>
        </field>
    </record>
</odoo>
