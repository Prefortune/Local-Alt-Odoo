<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="pf_base_document_layout_view_form" model="ir.ui.view">
    <field name="name">base.document.layout.view.form.inherit</field>
    <field name="model">base.document.layout</field>
    <field name="inherit_id" ref="web.view_base_document_layout"/>
    <field name="arch" type="xml">
        <xpath expr="//group/field[@name='paperformat_id']" position="after">
            <field name="pf_signature_layout" string="Company Signature"  widget="image" options="{'size': [0, 50]}"/>
        </xpath>
        </field>
</record>
</odoo>