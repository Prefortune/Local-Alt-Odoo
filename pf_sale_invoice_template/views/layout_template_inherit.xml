        </xpath>

        <!--report footer-->
        <xpath expr="//div[@t-attf-class='footer o_standard_footer o_company_#{company.id}_layout']" position="replace">
            <t t-foreach="docs" t-as="doc">
                <t t-if="doc._name == 'sale.order'">
                    <t t-set="lang" t-value="doc.partner_id.lang or 'en_US'"/>
                    <t t-set="direction" t-value="'rtl' if lang.startswith('he') or lang.startswith('ar') or lang.startswith('fa') else 'ltr'"/>
                </t>
                <t t-elif="doc._name == 'account.move'">
                    <t t-set="lang" t-value="o.partner_id.lang or 'en_US'"/>
                    <t t-set="direction" t-value="'rtl' if lang.startswith('he') or lang.startswith('ar') or lang.startswith('fa') else 'ltr'"/>
                </t>
            </t>
            <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
                <div class="text-center" style="border-top: 1px solid #ddd; bottom: 0; font-size: 14px; padding-top: 5px;">
                    <t t-if="direction == 'rtl'">
                        <div>
                            <p>
                            <span t-esc="company.name"/> | <span t-esc="company.street"/> | <span t-esc="company.city"/>
                            </p>
                        </div>
                        
                    </t>
                    <t t-else="">
                        <div>
                            <p>
                            <span t-esc="company.name"/> | <span t-esc="company.street"/> | <span t-esc="company.city"/>
                            </p>
                        </div>
                    </t>
                </div>
                <div style="margin-top:-10px;font-size: 12px;" class="text-end">
                    <t t-set-locale="lang" t-if="direction == 'rtl'">
                        <span t-translation="on">Page</span> <span class="page"/> <span t-translation="on">from</span> <span class="topage"/>
                    </t>
                    <t t-set-locale="lang" t-else="">
                        <span t-translation="on">Page</span> <span class="page"/> <span t-translation="on">from</span> <span class="topage"/>
                    </t>
                </div>
            </div>
       </xpath>
    </template>
