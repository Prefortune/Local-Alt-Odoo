<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-if="o._name == 'stock.picking' and o.picking_type_id.code == 'outgoing'"> 
            <t t-set="o" t-value="o.with_context(lang=o._get_report_lang())"/>
            <t t-call="pf_sale_invoice_template.custom_standard_external_layout">
                <t t-set="company" t-value="company_id or request.env.user.company_id"/>
                <t t-set="lang" t-value="o.partner_id.lang or 'en_US'"/>
                <t t-set="direction" t-value="'rtl' if lang.startswith('he') or lang.startswith('ar') or lang.startswith('fa') else 'ltr'"/>
                <br></br><br></br>
                <t t-if="direction == 'rtl'">
                    <div class="customer-info" style="margin-top: 40px; padding: 10px; background-color: #fff; border: 1px solid #ddd; border-radius: 3px; direction: rtl; text-align: right;">
                        <div><strong t-translation="on">To</strong> <span t-field="o.partner_id.name"/></div>
                        <div t-if="o.partner_id.vat"><strong t-translation="on">ID/Tax No:</strong> <span t-field="o.partner_id.vat"/></div>   
                        <div> <i class="fa fa-phone" style="margin-left: 6px;"/>:<span t-field="o.partner_id.phone"/></div>
                    </div>
                   
                    <div class="page" style="margin-top: 20px;">
                        <t t-if="o._name == 'stock.picking' and o.picking_type_id.code == 'outgoing'">
                            <t t-set="lines" t-value="o.move_ids"/>
                            <table class="table table-sm" style="width: 100%; border-collapse: collapse; text-align: right; font-size: 14px;">
                                <thead>
                                    <tr style="background-color: #f2f2f2; border: 1px solid #000;">
                                        <th style="width: 50%;border: 1px solid #000; padding: 6px;text-align:center;" t-translation="on">Products</th>
                                        <th style="width: 25%;border: 1px solid #000; padding: 6px;text-align:center" t-translation="on">Ordered</th>
                                        <th style="width: 25%;border: 1px solid #000; padding: 6px;text-align:center;background-color: #E6E9EF;"  t-translation="on">Shipped</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="lines" t-as="move">
                                        <td style="border: 1px solid #000; padding: 6px;">
                                            <span t-field="move.product_id"/>
                                            <p t-if="move.description_picking and move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name">
                                                <span t-field="move.description_picking"/>
                                            </p>
                                        </td>
                                        <td style="border: 1px solid #000; padding: 6px;text-align:center">
                                            <span t-field="move.product_uom_qty"/> 
                                            <span t-field="move.product_uom" groups="uom.group_uom"></span>
                                            <span t-if="move.product_packaging_id">
                                                (<span t-field="move.product_packaging_qty" t-options='{"widget": "integer"}'/>
                                                <span t-field="move.product_packaging_id"/>)
                                            </span>
                                        </td>
                                        <td style="border: 1px solid #000; padding: 6px;text-align:center;background-color: #E6E9EF;">
                                            <span t-field="move.quantity"/> 
                                            <span t-field="move.product_uom" groups="uom.group_uom"></span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                
                        <t t-set="backorders" t-value="o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))"/>
                        <div t-if="not (o.backorder_ids and backorders)" class="oe_structure"></div>
                        <div t-else="">
                            <p class="mt-5">
                                <span t-translation="on">Remaining quantities not delivered:</span>
                            </p>
                            <table class="table table-sm" style="table-layout: fixed;border: 1px solid black; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th name="th_sb_product"><strong t-translation="on">Products</strong></th>
                                        <th/>
                                        <th name="th_sb_quantity" class="text-center"><strong  t-translation="on">Quantity</strong></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="backorders.mapped('move_ids').filtered(lambda x: x.product_uom_qty)" t-as="bo_line">
                                        <td class="w-auto">
                                            <span t-field="bo_line.product_id"></span>
                                            <p t-if="bo_line.description_picking and bo_line.description_picking != bo_line.product_id.name and bo_line.description_picking != bo_line.product_id.display_name">
                                                <span t-field="bo_line.description_picking"></span>
                                            </p>
                                        </td>
                                        <td/>
                                        <td class="text-center w-auto">
                                            <span t-field="bo_line.product_uom_qty"/> 
                                            <span t-field="bo_line.product_uom" groups="uom.group_uom"></span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="notes-block" style="margin-top: 10px; padding: 15px; border: 1px solid #eee;height:120px; border-radius: 3px;
                    background-color: #fafafa; font-size: 12px; text-align:right; overflow: hidden;">
                        <div style="float: right; font-weight: bold; font-size: 14px; margin-right: 0;" t-translation="on">
                            Notes
                        </div>
                        
                        <div style="float: right; font-weight: normal;font-size:12px; margin-right: 10px;width:90%;">
                            <span t-out="o.note or ''" />
                        </div>
                    </div>
                    
                    <br></br>
                    <section t-if="company.pf_signature" id="signature" name="Signature" style="margin-top: 20px;">
                        <div class="row" style="justify-content: flex-start;margin-left:50px" name="signature">
                            <div class="col-auto" dir="ltr">
                                <img t-att-src="image_data_uri(company.pf_signature)" 
                                    style="max-height: 6rem; max-width: 100%; display: block;"/>
                                <h5 style="text-align: left;"  t-translation="on">Company Signature</h5>
                            </div>
                        </div>
                    </section>
                
                </t>
                
                <t t-else="">
                    <div class="customer-info" style="margin-top: 40px; padding: 10px; background-color: #fff; border: 1px solid #ddd; border-radius: 3px; text-align: left;">
                        <div>
                            <strong><span t-translation="on">To</span></strong> 
                            <span t-field="o.partner_id.name"/>
                        </div>
                        <div t-if="o.partner_id.vat">
                            <strong><span t-translation="on">ID/Tax No</span></strong> 
                            <span t-field="o.partner_id.vat"/>
                        </div>
                        <div><i class="fa fa-phone" style="margin-left: 4px;"/>: <span t-field="o.partner_id.phone"/></div>

                    </div>  

                    <div class="page" style="margin-top: 20px;">
                        <t t-if="o._name == 'stock.picking' and o.picking_type_id.code == 'outgoing'">
                            <t t-set="lines" t-value="o.move_ids"/>
                            <table class="table table-sm" style="width: 100%; border-collapse: collapse; text-align: right; font-size: 14px;">
                                <thead>
                                    <tr style="background-color: #f2f2f2; border: 1px solid #000;">
                                        <th style="width: 50%;border: 1px solid #000; padding: 6px;text-align:center;"><span t-translation="on">Product</span></th>
                                        <th style="width: 25%;border: 1px solid #000; padding: 6px;text-align:center"><span t-translation="on">Ordered</span></th>
                                        <th style="width: 25%;border: 1px solid #000; padding: 6px;text-align:center;background-color: #E6E9EF;"><span t-translation="on">Delivered</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="lines" t-as="move">
                                        <td style="border: 1px solid #000; padding: 6px;text-align:left">
                                            <span t-field="move.product_id"/>
                                            <p t-if="move.description_picking and move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name">
                                                <span t-field="move.description_picking"/>
                                            </p>
                                        </td>

                                        <td style="border: 1px solid #000; padding: 6px;text-align:center">
                                            <span t-field="move.product_uom" groups="uom.group_uom"></span>
                                            <span t-field="move.product_uom_qty"/>
                                            <span t-if="move.product_packaging_id">
                                                (<span t-field="move.product_packaging_qty" t-options='{"widget": "integer"}'/>
                                                <span t-field="move.product_packaging_id"/>)
                                            </span>
                                        </td>

                                        <td style="border: 1px solid #000; padding: 6px;text-align:center;background-color: #E6E9EF;">
                                            <span t-field="move.quantity"/>
                                            <span t-field="move.product_uom" groups="uom.group_uom"></span>

                                        </td>                                                        
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-set="backorders" t-value="o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))"/>
                        <div t-if="not (o.backorder_ids and backorders)" class="oe_structure"></div>
                        <div t-else="">
                            <p class="mt-5">
                                <span t-translation="on">Remaining quantities not yet delivered:</span>
                            </p>
                            <table class="table table-sm" style="table-layout: fixed;border: 1px solid black; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th name="th_sb_product"><strong> <span t-translation="on">Product</span></strong></th>
                                        <th/>

                                        <th name="th_sb_quantity" class="text-center"><strong><span t-translation="on">Quantity</span></strong></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="backorders.mapped('move_ids').filtered(lambda x: x.product_uom_qty)" t-as="bo_line">
                                        <td class="w-auto">
                                            <span t-field="bo_line.product_id"></span>
                                            <p t-if="bo_line.description_picking and bo_line.description_picking != bo_line.product_id.name and bo_line.description_picking != bo_line.product_id.display_name">
                                                <span t-field="bo_line.description_picking"></span>
                                            </p>
                                        </td>
                                        <td/>
                                        <td class="text-center w-auto">
                                            <span t-field="bo_line.product_uom_qty"/>
                                            <span t-field="bo_line.product_uom" groups="uom.group_uom"></span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="notes-block"
                        style="margin-top: 10px; padding: 15px; border: 1px solid #eee;height:120px; border-radius: 3px;
                                background-color: #fafafa; font-size: 12px; text-align:left; overflow: hidden;">
                        <div style="float: left; font-weight: bold; font-size: 14px; margin-left: 0;">
                            <span t-translation="on">Note:</span>
                        </div>
                        <div style="float: left; font-weight: normal;font-size:12px; margin-left: 10px;width:90%;">
                            <span t-out="o.note or ''" />
                        </div>
                    </div>

                        <br></br>

                        <section t-if="company.pf_signature" id="signature" name="Signature" style="margin-top:20px;">
                            <div class="row justify-content-end" name="signature">
                                <div class="col-auto text-end" style="text-align: right;">
                                    <img t-att-src="image_data_uri(company.pf_signature)" 
                                        style="max-height: 6rem; max-width: 5cm; display: block; margin-right: 2px; margin-left: auto;" />
                                    <h5 style="text-align: right;margin-right:2px"><span t-translation="on">Company</span></h5>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
            </t>
        </xpath>
    </template>
    </odoo>