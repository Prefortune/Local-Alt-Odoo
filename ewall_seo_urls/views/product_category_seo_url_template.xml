<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Product Page Breadcrumb href Values Changes -->
	<template id="product_inherit" inherit_id="website_sale.product" name="Product">
		<xpath expr="//ol[@class='o_wsale_breadcrumb breadcrumb p-0 mb-4 m-lg-0']/li[@class='breadcrumb-item']" position="replace">
			<li t-nocache="The category does not have to be cached, as the product can be accessed via different paths." t-if="category" class="breadcrumb-item">
                <t t-if="category.seo_url">
                    <a class="py-2 py-lg-0" t-att-href="keep('/shop/category/%s' % (category.seo_url), category=0, attribute_value=0, tags=0)">   
                        <i class="oi oi-chevron-left d-lg-none me-1" role="presentation"/><t t-out="category.name"/>
                    </a>
                </t>
                <t t-else="">
                    <a class="py-2 py-lg-0" t-att-href="keep('/shop/category/%s' % slug(category), category=0, attribute_value=0, tags=0)">
                        <i class="oi oi-chevron-left d-lg-none me-1" role="presentation"/><t t-out="category.name"/>
                    </a>
                </t>
            </li>
		</xpath>
	</template>
    <!-- Products page Breadcrumb href Values Changes -->
	<template id="products_breadcrumb_inherit" inherit_id="website_sale.products_breadcrumb" name="Products Breadcrumb">
		 <xpath expr="//t[@t-foreach='category.parents_and_self']" position="replace">
		 	<t t-foreach="category.parents_and_self" t-as="cat">
                <li t-if="cat == category" class="breadcrumb-item">
                    <span class="d-inline-block" t-field="cat.name"/>
                </li>
                <li t-else="" class="breadcrumb-item">
                    <t t-if="cat.seo_url">
                        <a t-att-href="keep('/shop/category/%s' % (cat.seo_url), category=0)" t-field="cat.name"/>
                    </t>
                    <t t-else=''>
                        <a t-att-href="keep('/shop/category/%s' % slug(cat), category=0)" t-field="cat.name"/>
                    </t>
                </li>
            </t>
		 </xpath>
	</template>
    <!-- category Listing Values href Values Changes -->
	<template id="website_sale_filmstrip_categories" inherit_id="website_sale.filmstrip_categories" name="Categories Filmstrip">
    <xpath expr="//a[@class='text-decoration-none']" position="attributes">
        <attribute name="t-att-href">keep('/shop/category/' + (c.seo_url), category=0) if c.seo_url else keep('/shop/category/' + slug(c), category=0)</attribute>
    </xpath>
    </template>
    <!-- Product Attributes href Values Changes -->
    <template id="products_attributes_inherits" inherit_id="website_sale.products_attributes" active="True" name="Attributes &amp; Variants filters">
    	<xpath expr="//div[@t-if='attrib_values or tags']" position="replace">
            <div t-if="attrib_values or tags" class="accordion-item rounded-0 border-top-0 py-3">
                <t t-if="category.seo_url">
                    <a t-att-href="keep('/shop' + ('/category/' + (category.seo_url)) if category else None, attribute_value=0, tags=0)" t-attf-class="btn btn-{{navClass}} d-flex align-items-center py-1" title="Clear Filters">
                        <small class="mx-auto"><b>Clear Filters</b></small>
                        <i class="oi oi-close" role="presentation"/>
                    </a>
                </t>
                <t t-else="">
                    <a t-att-href="keep('/shop' + ('/category/' + slug(category)) if category else None, attribute_value=0, tags=0)" t-attf-class="btn btn-{{navClass}} d-flex align-items-center py-1" title="Clear Filters">
                        <small class="mx-auto"><b>Clear Filters</b></small>
                        <i class="oi oi-close" role="presentation"/>
                    </a>
                </t>
            </div>
    	</xpath>
    	<xpath expr="//input[@t-if='category']" position="attributes">
    		<attribute name="t-att-value">category.seo_url if category.seo_url else category.id</attribute>
    	</xpath>
    </template>
</odoo>