<?xml version="1.0"?>
<odoo>
    <data>
        <record id="stock_move_wizard_view" model="ir.ui.view">
            <field name="name">Import Serials for Picking</field>
            <field name="model">import.stock.move.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="picking_id" invisible="1"/>
                        <field name="file_name" invisible="1"/>
                        <field name="move_file" filename="file_name"/>
                    </group>
                    <footer>
                        <button string="Import" name="import_serials" class="oe_highlight" type="object"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="stock_move_wizard_action" model="ir.actions.act_window">
            <field name="name">Import Serials for Picking</field>
            <field name="res_model">import.stock.move.wizard</field>
            <field name="target">new</field>
            <field name="view_mode">form</field>
        </record>

        <record id="picking_inherited_view" model="ir.ui.view">
            <field name="name">Import Serials for Picking</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <header>
                    <button name="open_stock_move_wizard" string="Import Stock file" type="object" class="btn-primary" invisible="state in ('done','cancel') or picking_type_code not in ('incoming','internal')"/>
                </header>
            </field>
        </record>
    </data>
</odoo> 