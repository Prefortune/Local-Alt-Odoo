<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_event_field" model="ir.ui.view">
        <field name="name">inherit.event.field</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='address_id']" position="before">
                <field name="active_sponsorship"></field>
            </xpath>
        </field>
    </record>

    <record id="inherit_event_sponesorship" model="ir.ui.view">
        <field name="name">inherit.event.sponesorship</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Sponsorship" invisible="active_sponsorship == False">
                    <field name="event_sponsorship_ids" >
                            <list editable="bottom">
                              <field name="sponsorship_type"></field>
                              <field name="sponsorship_description"></field>
                              <field name="currency_id"></field>
                              <field name="sponsorship_amount"></field>
                            </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>


    <record id="inherit_event_sponesorship_payment" model="ir.ui.view">
        <field name="name">inherit.event.sponesorship.payment</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Sponsorship Apply" invisible="active_sponsorship == False">
                    <field name="event_sponsorship_payment_ids" >
                            <list editable="bottom">
                                    <field name="name"/>
                                    <field name="customer_email"/>
                                    <field name="phone"></field>
                                    <field name="sponsorship_type"/>
                                    <field name="amount_with_currency"/>
                                    <field name="payment_status" widget="badge" decoration-success="payment_status == 'paid'"/>
                            
                                </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>



    <template id="event_sponsership_template" name="event_sponsership" inherit_id="website_event.event_description_full">
        <xpath expr="//div[@class='o_wevent_sidebar_block']" position="inside">
            <t t-if="event.active_sponsorship">
    
                <div class="card position-relative"  style="width: 14rem; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);">
                    <div class="card-body">
                        <h6 class="card-title text-primary">🎖️ Sponsorship Packages</h6>
                            <div class="card" style="width: 12rem;">
                                <ul class="list-group list-group-flush">
                                    <t t-foreach="event.event_sponsorship_ids" t-as="sponesorship">
                                        <li class="list-group-item">
                                            <div>
                                                <div class="position-absolute top-0 end-0 me-1">   
                                                    <i class="fa fa-info text-primary"
                                                        title="View Details"
                                                        style="font-size:0.75rem; cursor:pointer;"
                                                        aria-hidden="true"
                                                        t-att-id="'info-icon-' + str(sponesorship.id)"
                                                        data-bs-toggle="modal"
                                                        t-att-data-bs-target="'#infoModal-' + str(sponesorship.id)" />
                                                </div>

                                                <strong t-esc="sponesorship.get_sponsorship_type_display()"/>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span>
                                                    
                                                    <span t-esc="sponesorship.currency_id.symbol"/>
                                                    <span t-esc="sponesorship.sponsorship_amount"/>
                                                </span>
                                                <a t-attf-href="/sponsorship/apply/#{sponesorship.id}" class="btn btn-outline-primary btn-sm" target="_top">
                                                    Apply
                                                </a>
                                                  
                                            </div>
                                        </li>
                                    </t>
                                </ul>
                          </div>
                    </div>
              </div>
              <t t-if="sponesorship">
              <t t-if="sponesorship.id">
                <t t-foreach="event.event_sponsorship_ids" t-as="sponesorship">
                 <div class="modal fade"
                            t-att-id="'infoModal-' + str(sponesorship.id)"
                            tabindex="-1"
                            t-att-aria-labelledby="'infoModalLabel-' + str(sponesorship.id)"
                            aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title"
                                            t-att-id="'infoModalLabel-' + str(sponesorship.id)">
                                            <strong t-esc="sponesorship.get_sponsorship_type_display()"/>
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <t t-esc="sponesorship.sponsorship_description"/>
                                    </div>
                                </div>
                            </div>
                </div></t>
        </t>
    </t>
            </t>
        </xpath>
    </template>
</odoo>
