<odoo>
    <record id="view_res_config_settings_inherit_stripe" model="ir.ui.view">
        <field name="name">res.config.settings.stripe.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Stripe Settings" string="Stripe Settings">
                    <h2>Stripe Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6">
                            <div class="content-group mt16">
                                <span>Stripe Secret Key</span>
                                <field name="stripe_secret_key" password="True"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
