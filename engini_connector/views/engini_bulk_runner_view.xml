<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_engini_webhook_bulk_runner_form" model="ir.ui.view">
        <field name="name">engini.webhook.bulk.runner.form</field>
        <field name="model">engini.webhook.bulk.runner</field>
        <field name="arch" type="xml">
            <form string="Bulk Webhook Sender">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="batch_size"/>
                        <field name="timeout"/>
                    </group>
                    <group string="סטטוס">
                        <field name="state"/>
                        <field name="total_records"/>
                        <field name="processed_records"/>
                        <field name="success_count"/>
                        <field name="error_count"/>
                    </group>
                    <group string="תאריכים" invisible="state == 'draft'">
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group string="שגיאות" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <footer>
                        <button name="action_start_bulk_run" type="object" string="התחל ריצה" class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_stop_bulk_run" type="object" string="עצור" class="btn-warning" invisible="state != 'running'"/>
                        <button name="action_reset_bulk_run" type="object" string="איפוס" class="btn-secondary" invisible="state not in ['done', 'failed']"/>
                        <button string="סגור" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_engini_webhook_bulk_runner" model="ir.actions.act_window">
        <field name="name">Bulk Order Sender</field>
        <field name="res_model">engini.webhook.bulk.runner</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo> 