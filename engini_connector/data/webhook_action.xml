<odoo>
    <record id="action_send_orders_to_engini" model="ir.actions.server">
        <field name="name">Send to Engini Webhook</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code">
            action = records.send_to_webhook()
        </field>
    </record>
</odoo>
