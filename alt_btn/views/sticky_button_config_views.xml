<odoo>
    <record id="view_sticky_button_config_form" model="ir.ui.view">
        <field name="name">sticky.button.config.form</field>
        <field name="model">sticky.button.config</field>
        <field name="arch" type="xml">
            <form string="Sticky Button Settings">
                <sheet>
                    <group>
                        <field name="button_text"/>
                        <field name="button_url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo> 