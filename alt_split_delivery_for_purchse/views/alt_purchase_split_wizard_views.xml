<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_alt_purchase_split_wizard_form" model="ir.ui.view">
        <field name="name">alt.purchase.split.wizard.form</field>
        <field name="model">alt.purchase.split.wizard</field>
        <field name="arch" type="xml">
            <form string="פיצול הזמנה למנות משלוח">
                <header>
                    <button name="action_confirm_split_count" 
                            string="Confirm Number of Batches" 
                            type="object" 
                            class="oe_highlight"
                            invisible="state != 'count'"/>
                    <button name="action_recalculate" 
                            string="Recalculate" 
                            type="object" 
                            class="btn-secondary"
                            invisible="state != 'configure'"/>
                    <button name="action_save_batches" 
                            string="Save Configuration" 
                            type="object" 
                            class="oe_highlight"
                            invisible="state != 'configure'"/>
                    <button name="action_create_split_deliveries" 
                            string="Update Batch Details" 
                            type="object" 
                            class="oe_highlight"
                            invisible="state != 'saved'"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="purchase_order_id" readonly="1"/>
                        </h1>
                    </div>
                    
                    <field name="state" invisible="1"/>
                    
                    <!-- Stage 1: Select number of batches -->
                    <div invisible="state != 'count'">
                        <group>
                            <group>
                                <field name="split_count"/>
                            </group>
                            <group>
                                <div class="alert alert-info">
                                    <strong>Stage 1:</strong> Select the number of batches you want to split the order into
                                </div>
                            </group>
                        </group>
                    </div>
                    
                    <!-- Stage 2: Configure batches -->
                    <div invisible="state != 'configure'">
                        <group>
                            <group>
                                <div class="alert alert-success">
                                    <strong>Stage 2:</strong> Configure details for each batch - delivery address, products, date and notes
                                </div>
                            </group>
                        </group>
                        
                        <!-- Products from order - read only -->
                        <div class="alert alert-info">
                            <strong>Products from Order:</strong>
                        </div>
                        <field name="purchase_order_line_ids" widget="one2many">
                            <list readonly="1" create="false" edit="false" delete="false">
                                <field name="product_name"/>
                                <field name="original_qty"/>
                                <field name="remaining_qty" decoration="warning" string="Remaining"/>
                                <field name="product_uom"/>
                            </list>
                        </field>
                        
                        <!-- Delivery batches -->
                        <div class="alert alert-warning mt-4">
                            <strong>Delivery Batches:</strong>
                        </div>
                        <field name="split_delivery_ids">
                            <list readonly="1" create="false" edit="false" delete="false">
                                <field name="delivery_index" readonly="1"/>
                                <field name="partner_id"/>
                                <field name="scheduled_date" widget="date"/>
                                <field name="delivery_notes"/>
                                <!-- <field name="products_display" readonly="1"/> -->
                                <field name="product_line_ids" widget="one2many" invisible="1">
                                    <list editable="bottom">
                                        <field name="product_name" readonly="1"/>
                                        <field name="product_qty"/>
                                        <field name="product_uom" readonly="1"/>
                                    </list>
                                </field>
                            </list>
                        </field>
                    </div>
                    
                    <!-- Saved configuration -->
                    <div invisible="state != 'saved'">
                        <group>
                            <group>
                                <div class="alert alert-info">
                                    <strong>Configuration Saved!</strong> You can now update batch details or create the actual deliveries.
                                </div>
                            </group>
                        </group>
                        
                        <!-- Products from order -->
                        <div class="alert alert-info">
                            <strong>Products from Order:</strong>
                        </div>
                        <field name="purchase_order_line_ids" widget="one2many">
                            <list readonly="1" create="false" edit="false" delete="false">
                                <field name="product_name"/>
                                <field name="original_qty"/>
                                <field name="remaining_qty" decoration="warning" string="Remaining"/>
                                <field name="product_uom"/>
                            </list>
                        </field>
                        
                        <!-- Delivery batches -->
                        <div class="alert alert-warning mt-4">
                            <strong>Delivery Batches:</strong>
                        </div>
                        <field name="split_delivery_ids">
                            <list readonly="1" create="false" edit="false" delete="false">
                                <field name="delivery_index" readonly="1"/>
                                <field name="partner_id"/>
                                <field name="scheduled_date" widget="date"/>
                                <field name="delivery_notes"/>
                                <!-- <field name="products_display" readonly="1"/> -->
                                <field name="product_line_ids" widget="one2many" invisible="1">
                                    <list editable="bottom">
                                        <field name="product_name" readonly="1"/>
                                        <field name="product_qty"/>
                                        <field name="product_uom" readonly="1"/>
                                    </list>
                                </field>
                            </list>
                        </field>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Wizard Line Form View -->
    <record id="view_alt_purchase_split_wizard_line_form" model="ir.ui.view">
        <field name="name">alt.purchase.split.wizard.line.form</field>
        <field name="model">alt.purchase.split.wizard.line</field>
        <field name="arch" type="xml">
            <form string="מנה משלוח">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="delivery_index" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="scheduled_date" widget="date"/>
                            <field name="delivery_notes"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="zip"/>
                        </group>
                    </group>
                    
                        <notebook>
                            <page string="מוצרים במנה">
                                <field name="product_line_ids">
                                    <list editable="bottom">
                                        <field name="product_name" readonly="1"/>
                                        <field name="product_qty"/>
                                        <field name="product_uom" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Recalculate Popup Form View -->
    <record id="view_alt_purchase_split_wizard_recalculate_form" model="ir.ui.view">
        <field name="name">alt.purchase.split.wizard.recalculate.form</field>
        <field name="model">alt.purchase.split.wizard.recalculate</field>
        <field name="arch" type="xml">
            <form string="חישוב מחדש">
                <header>
                    <button name="action_confirm_recalculate" 
                            string="אישור" 
                            type="object" 
                            class="oe_highlight"/>
                    <button name="action_cancel_recalculate" 
                            string="ביטול" 
                            type="object" 
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="alert alert-warning">
                        <strong>אזהרה!</strong>
                    </div>
                    <div class="oe_title">
                        <h1>חישוב מחדש</h1>
                    </div>
                    <div class="alert alert-danger">
                        <p><strong>פעולה זו תמחק את כל המידע שהזנת עד כה.</strong></p>
                        <p>כל הכתובות, כמויות המוצרים וההערות שיוזנו יימחקו.</p>
                        <p>תוכל לבחור מספר מנות מחדש ולהגדיר הכל מהתחלה.</p>
                    </div>
                    <div class="alert alert-info">
                        <p><strong>האם אתה בטוח שברצונך להמשיך?</strong></p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Recalculate Popup Action -->
    <record id="action_alt_purchase_split_wizard_recalculate" model="ir.actions.act_window">
        <field name="name">חישוב מחדש</field>
        <field name="res_model">alt.purchase.split.wizard.recalculate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Wizard Action -->
    <record id="action_alt_purchase_split_wizard" model="ir.actions.act_window">
        <field name="name">פיצול הזמנה למנות משלוח</field>
        <field name="res_model">alt.purchase.split.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'purchase_order_id': active_id}</field>
    </record>
</odoo>
