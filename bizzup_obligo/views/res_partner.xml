<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_delivery_ups" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.delivery.ups</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="credit" position="before">
                <field name="obligo"/>
                <field name="postponed_check_total" invisible="1"/>
                <field name="show_credit_limit" invisible="1"/>
            </field>
            <field name="use_partner_credit_limit" position="attributes">
                <attribute name="invisible">show_credit_limit == False</attribute>
            </field>
            <field name="credit_limit" position="attributes">
                <attribute name="invisible">show_credit_limit == False</attribute>
            </field>

        </field>
    </record>

    <record id="view_partner_form_inherit_delivery_ups" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.delivery.ups</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='credit']" position="before">
                <field name="postponed_check_total" invisible="1"/>
                <field name="obligo"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_tree_obligo" model="ir.ui.view">
        <field name="name">res.partner.tree.obligo</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Customers Obligations">
                <field name="name"/>
                <field name="credit"/>
                <field name="credit_limit"/>
                <field name="obligo"/>
                <field name="postponed_check_total"/>
            </list>
        </field>
    </record>

    <record id="res_partner_action_customerse" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_res_partner_tree_obligo"/>
    </record>

    <menuitem id="menu_account_customerss"
              name="Obligo"
              parent="account.menu_finance_reports"
              action="res_partner_action_customerse"/>

</odoo>