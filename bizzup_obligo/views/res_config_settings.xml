<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.auth.signup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <div class="app_settings_block" data-string="Credit Settings" string="Credit Settings"
                     name="credit_settings_block">
                    <h2>Credit Limit Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6">
                            <div class="form-group">
                                <field name="credit_tolerance"/>
                                <label for="credit_tolerance" string="Tolerance Amount"/>
                                <div class="text-muted">
                                    Additional amount allowed over the credit limit.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
