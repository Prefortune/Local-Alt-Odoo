<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Backend report-->
    <template id="report_report_invoice_document_inherit" inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_product_internal_ref" class="text-start">Internal Ref.</th>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="after">
            <td name="td_product_internal_ref"><span t-field="line.product_id.default_code" class="text-start"></span></td>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="replace">
            <td name="td_product_internal_ref"><span t-field="line.product_description" class="text-start"></span></td>
        </xpath>
    </template>

    <record id="account_form_inherit_bizzup_internal_ref" model="ir.ui.view">
        <field name="name">account.move.form.inherit.bizzup.internal.ref</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='price_unit']" position="after">
                  <field name="product_description" widget="section_and_note_text"/>
            </xpath>
        </field>
    </record>

</odoo>
