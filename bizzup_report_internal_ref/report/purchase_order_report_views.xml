<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Backend report-->
    <!--Purchase Order-->
    <template id="report_purchaseorder_document_inherit" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_product_internal_ref" class="text-start">Internal Ref.</th>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <td id="td_product_internal_ref"><span t-field="line.product_id.default_code"></span></td>
        </xpath>
        <xpath expr="//td[@id='product']" position="replace">
            <td id="product"><span t-field="line.product_description"></span></td>
        </xpath>
    </template>

    <!--RFQ-->
    <template id="report_report_purchasequotation_document_inherit" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_product_internal_ref" class="text-start">Internal Ref.</th>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <td id="td_product_internal_ref"><span t-field="order_line.product_id.default_code"></span></td>
        </xpath>
        <xpath expr="//td[@id='product']" position="replace">
            <td id="product"><span t-field="order_line.product_description"></span></td>
        </xpath>
    </template>

    <!--Portal Content-->
    <template id="report_purchase_order_portal_content_inherit" inherit_id="purchase.purchase_order_portal_content">
        <xpath expr="//table[@id='purchase_order_table']//tr/th" position="after">
            <th id="th_product_internal_ref" class="text-end">התייחסות פנימית</th>
        </xpath>
        <xpath expr="//td[@id='product_name']" position="after">
           <td id="td_product_internal_ref">
                <span t-field="line.product_id.default_code"/>
            </td>
        </xpath>
        <xpath expr="//td[@id='product_name']" position="replace">
           <td id="product_name">
                <span t-field="line.product_description"/>
            </td>
        </xpath>
    </template>

    <record id="purchase_order_form_inherit_bizzup_internal_ref" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.bizzup.internal.ref</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='price_unit']" position="after">
                  <field name="product_description" widget="section_and_note_text"/>
            </xpath>
        </field>
    </record>

</odoo>
