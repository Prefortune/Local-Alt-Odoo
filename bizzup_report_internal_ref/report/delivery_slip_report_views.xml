<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Backend report-->
    <!--Delivery Slip-->
    <template id="report_report_delivery_document_inherit" inherit_id="stock.report_delivery_document">
        <xpath expr="//th[@name='th_sm_product']" position="after">
            <th name="th_product_internal_ref" class="text-start">Internal Ref.</th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']//td" position="after">
            <td name="td_product_internal_ref"><span t-field="move.product_id.default_code" class="text-start"></span></td>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']//td" position="replace">
            <td name="td_product_name"><span t-field="move.product_description" class="text-start"></span></td>
        </xpath>

        <xpath expr="//th[@name='th_sml_product']" position="after">
            <th name="th_product_internal_ref" class="text-start">Internal Ref.</th>
        </xpath>
    </template>

    <template id="report_stock_report_delivery_has_serial_move_line_inherit" inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//t[@name='move_line_lot']" position="before">
            <th name="th_product_internal_ref" class="text-start">Internal Ref.</th>
        </xpath>
    </template>

    <template id="report_stock_report_delivery_aggregated_move_lines_inherit" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//tr//td" position="after">
            <td name="td_product_internal_ref"><span t-esc="aggregated_lines[line]['default']" class="text-start"></span></td>
        </xpath>
        <xpath expr="//tr//td" position="replace">
            <td name="td_product_internal_ref"><span t-esc="aggregated_lines[line]['product_description']" class="text-start"></span></td>
        </xpath>

    </template>

    <record id="view_picking_form_inherit_remove_default" model="ir.ui.view">
        <field name="name">view.picking.form.inherit.remove.default</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description_picking']" position="after">
                <field name="product_description"/>
            </xpath>
        </field>
    </record>

</odoo>
