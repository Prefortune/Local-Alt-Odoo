<?xml version="1.0"?>
<odoo>

    <record id="view_account_receipt_line_form_inherit" model="ir.ui.view">
        <field name="name">lyg.account.receipt.line.form.inherit</field>
        <field name="model">lyg.account.receipt.line</field>
        <field name="inherit_id" ref="lyg_receipt.view_account_receipt_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/group[2]" position="replace">
                <group>
                    <field name="tranzila_npay"/>
                    <field name="tranzila_fpay"/>
                    <field name="tranzila_spay"/>
                    <field name="tranzila_line_no"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

