<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tranzila Redirect form view-->
    <!-- Inherited Payment Acquirer for Tranzila-->
    <record id="payment_provider_form_inherit_bizzup" model="ir.ui.view">
        <field name="name">Tranzila Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
<!--                <group attrs="{'invisible': [('code', '!=', 'tranzila')]}">-->
<!--                    <field name="is_payment"/>-->
<!--                    <field name="payment_mode" attrs="{'invisible': [('is_payment', '=', False)]}"/>-->
<!--                    <field name="payment_limit" attrs="{'invisible': [('is_payment', '=', False)]}"/>-->
<!--                </group> -->
                <group invisible="code != 'tranzila'">
                    <field name="is_payment"/>
                    <field name="payment_mode" invisible="is_payment == False"/>
                    <field name="payment_limit" invisible="is_payment == False"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
