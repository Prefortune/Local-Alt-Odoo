<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_fb_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr='//page[@name="lead"]' position='after'>
                <page name="categorization" string="Facebook Info">
                    <group name="facebook_info" string="Facebook Info" col="2">
                        <group>
                            <field name="facebook_lead_id"/>
                            <field name="facebook_date_create" string="Date Create"/>
                            <field name="facebook_page_id"/>
                            <field name="facebook_form_id"/>
                        </group>
                        <group>
                            <field name="facebook_ad_set_id"/>
                            <field name="facebook_ad_id"/>
                            <field name="facebook_campaign_id"/>
                            <field name="facebook_is_organic" invisible="1"/>
                        </group>

                    </group>
                </page>
            </xpath>
            <xpath expr='//field[@name="user_id"]' position='before'>
                <label for="mobile" class="oe_inline"/>
                <div class="o_row o_row_readonly">
                    <field name="mobile" widget="phone" string="Mobile"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>