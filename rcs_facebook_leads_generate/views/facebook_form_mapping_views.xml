<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="facebook_form_mapping_form" model="ir.ui.view">
        <field name="name">facebook.form.mapping.form</field>
        <field name="model">facebook.form.mapping</field>
        <field name="arch" type="xml">
            <form string="Facebook form">
                <sheet>
                    <group>
                        <field name="facebook_field"/>
                        <field name="odoo_field" options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="facebook_form_mapping_list" model="ir.ui.view">
        <field name="name">facebook.form.mapping.list</field>
        <field name="model">facebook.form.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="facebook_field"/>
                <field name="odoo_field"/>
            </list>
        </field>
    </record>

    <record id="action_facebook_form_mapping" model="ir.actions.act_window">
        <field name="name">Default Mappings</field>
        <field name="res_model">facebook.form.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="facebook_form_mapping_list"/>
        <field name="help" type="html">
            <p/>
        </field>
    </record>

</odoo>