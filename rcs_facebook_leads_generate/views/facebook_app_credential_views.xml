<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="facebook_app_credential_form" model="ir.ui.view">
        <field name="name">facebook.app.credential.info.form</field>
        <field name="model">facebook.app.credential.info</field>
        <field name="arch" type="xml">
            <form string="Facebook App Configuration">
                <header>

                    <button name="action_get_facebook_access_token"
                            type="object"
                            string="Generate Token"
                            class="btn-primary"/>

                    <button name="action_get_facebook_pages"
                            type="object"
                            string="Fetch Facebook Pages"
                            class="btn-primary"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_facebook_page"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list">
                            <field name="facebook_page_count" widget="statinfo" string="Facebook Pages"/>
                        </button>
                    </div>
                    <group>
                        <group string="Facebook Configuration" col="2">
                            <field name="facebook_app_id"/>
                            <field name="facebook_app_secret"/>
                        </group>
                        <group string="Others">
                            <field name="company_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Access Token">
                            <field name="facebook_user_access_token" readonly="True"/>
                        </group>
                        <group string="Token Status">
                            <field name="facebook_user_access_token_state"/>
                            <field name="facebook_user_access_token_state_message" widget="html"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!--    Search View With Groups -->
    <record id="facebook_app_credential_search" model="ir.ui.view">
        <field name="name">facebook.app.credential.info.search</field>
        <field name="model">facebook.app.credential.info</field>
        <field name="arch" type="xml">
            <search>
                <field name="facebook_user_access_token_state"/>
                <group expand="0" string="Group by">
                    <filter name="Token" context="{'group_by': 'facebook_user_access_token_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="facebook_app_credential_list" model="ir.ui.view">
        <field name="name">facebook.app.credential.list</field>
        <field name="model">facebook.app.credential.info</field>
        <field name="arch" type="xml">
            <list string="Facebook App Credential">
                <field name="facebook_app_id"/>
                <field name="facebook_app_secret" optional="hide"/>
                <field name="facebook_user_access_token_state"/>
                <field name="facebook_user_access_token" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_facebook_app_credential" model="ir.actions.act_window">
        <field name="name">Facebook App Credential</field>
        <field name="res_model">facebook.app.credential.info</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="rcs_facebook_leads_generate.facebook_app_credential_list"/>
    </record>

</odoo>
