<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited sale order for add new boolean and for readonly the field-->
    <record id="view_sale_order_bpac" model="ir.ui.view">
        <field name="name">sale.order.form.view.bpac</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="is_group" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']"
                   position="attributes">
                <attribute name="readonly">is_group</attribute>
            </xpath>
        </field>
    </record>
</odoo>
