<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_bpac" model="ir.ui.view">
        <field name="name">purchase.order.inherited.form.bpac</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='price_unit']" position="after">
                <field name="is_group" invisible="1"/>
            </xpath>
            <xpath expr="//list//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">is_group</attribute>
            </xpath>
        </field>
    </record>
</odoo>
