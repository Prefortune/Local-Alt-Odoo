<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited product for add new boolean and for readonly the field-->
    <record id="product_product_view_form_bpac" model="ir.ui.view">
        <field name="name">product.product.form.view.bpac</field>
        <field name="model">product.product</field>
        <field name="inherit_id"
               ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lst_price']" position="after">
                <field name="is_group" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='lst_price']" position="attributes">
                <attribute name="readonly">is_group</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherited product normalized for add new boolean and for readonly the field -->
    <record id="product_product_view_form_normalized_bpac" model="ir.ui.view">
            <field name="name">product.product.form.view.bpac</field>
        <field name="model">product.product</field>
        <field name="inherit_id"
               ref="product.product_product_view_form_normalized"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="is_group" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="readonly">is_group</attribute>
            </xpath>
        </field>
    </record>
</odoo>
