<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Category -->
    <record model="ir.module.category" id="module_category_all_bpac">
        <field name="name">Edit Unit Price</field>
        <field name="description">Helps you manage your institutes
            different-different users.
        </field>
        <field name="sequence">105</field>
        <field name="parent_id" eval="False"/>
    </record>

    <!-- Pricelist Category -->
    <record id="module_category_bpac" model="ir.module.category">
        <field name="name">Category Price</field>
        <field name="parent_id"
               ref="bizzup_price_access_customization.module_category_all_bpac"/>
        <field name="sequence">16</field>
    </record>

    <!-- Change in Docs Group -->
    <record id="group_bpac_change_docs" model="res.groups">
        <field name="name">Change In Docs</field>
        <field name="category_id" ref="module_category_bpac"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="implied_ids"
               eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Admin Group -->
    <record id="group_bpac_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="module_category_bpac"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="implied_ids"
               eval="[(4, ref('bizzup_price_access_customization.group_bpac_change_docs'))]"/>
    </record>
</odoo>

