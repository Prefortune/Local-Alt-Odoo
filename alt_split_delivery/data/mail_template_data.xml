<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="pf_mail_template_sale_multi_shipping" model="mail.template">
            <field name="name">Sale Order Multi-Shipping Confirmation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">טופס משלוחים מרובים עבור הזמנה {{object.name}}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
            <table dir="rtl" border="0" cellpadding="0" cellspacing="0" style="background-color:#FFFFFF;width:100%;font-family:Verdana, Arial,sans-serif;color:#2F4F4F;text-align:right;">
                    <tbody>
                        <tr>
                            <td align="center">
                                <table border="0" cellpadding="0" cellspacing="0" width="590" style="background-color:#ffffff;padding:16px;color:#2f4f4f;
               font-family:Verdana, Arial, sans-serif;text-align:right;">
                                    <tbody>
                                        <!-- Logo -->
                                        <tr>
                                            <td align="center" style="padding:8px 0 12px 0;">
                                                <img t-attf-src="/logo.png?company={{ object.company_id.id }}" t-att-alt="object.company_id.name" style="display:block;width:110px;height:auto;"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <hr style="border:none;height:1px;background:#cccccc;opacity:0.25;margin:0;"/>
                                            </td>
                                        </tr>

                                        <!-- Greeting -->
                                        <tr>
                                            <td style="padding:12px 8px 0 8px;">
                                                <div style="font-size:20px;font-weight:bold;margin-bottom:6px;">
                  שלום                                                    <span>
                                                        <t t-out="object.partner_id.name or 'לקוח/ה יקר/ה'"/>
                                                    </span>,
                                                </div>
                                                <div style="font-size:14px;line-height:1.8;margin-top:4px;">
                  תודה שבחרת ב                                                    <b>
                                                        <t t-out="object.company_id.name"/>
                                                    </b>!
                                                </div>
                                                <div style="font-size:14px;line-height:1.8;margin-top:8px;">
                  מאחר ובחרת באפשרות של                                                    <strong>משלוחים מרובים</strong>, יצרנו עבורך גישה נוחה לפורטל שלנו.                                                    <br/>
                  שם תוכל/י להזין את כתובות המשלוח ולחלק את הכמויות בין ההזמנות השונות.
                                                </div>
                                            </td>
                                        </tr>

                                        <!-- Button -->
                                        <tr>
                                            <td align="center" style="padding:16px 8px;">
                                                <a t-attf-href="{{ object.alt_split_delivery_url or '#' }}" style="background-color:#2F4F4F;padding:12px 24px;border-radius:6px;color:#ffffff !important;
                          text-decoration:none;display:inline-block;font-size:14px;font-weight:bold;">
                  מעבר לפורטל המשלוחים
                                                </a>
                                            </td>
                                        </tr>

                                        <!-- Closing -->
                                        <tr>
                                            <td style="padding:12px 8px;font-size:14px;line-height:1.8;">
                במידה ותצטרך עזרה – אנחנו כאן בשבילך.                                                <br/>
                בברכה,                                                <br/>
                צוות                                                <t t-out="object.company_id.name"/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>
                                                <hr style="border:none;height:1px;background:#cccccc;opacity:0.25;margin:0;"/>
                                            </td>
                                        </tr>

                                        <!-- Footer -->
                                        <tr>
                                            <td style="padding:8px;font-size:12px;color:#6f6f6f;">
                                                <div>
                                                    <t t-out="object.company_id.name"/>
                                                </div>
                                                <div style="opacity:.85;margin-top:4px;">
                                                    <t t-out="object.company_id.phone or ''"/>
                                                    <t t-if="object.company_id.email"> |
                                                        <a t-att-href="'mailto:%s' % object.company_id.email" style="color:#6f6f6f;text-decoration:none;" t-out="object.company_id.email"/>
                                                    </t>
                                                    <t t-if="object.company_id.website"> |
                                                        <a t-att-href="object.company_id.website" style="color:#6f6f6f;text-decoration:none;" t-out="object.company_id.website"/>
                                                    </t>
                                                </div>
                                            </td>
                                        </tr>

                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </field>
            <!-- <field name="lang">{{ object.partner_id.lang }}</field> -->
            <!-- <field name="auto_delete" eval="True"/> -->
        </record>

    </data>
</odoo>
