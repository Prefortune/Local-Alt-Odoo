<odoo>
    <record id="view_trainsnet_form" model="ir.ui.view">
        <field name="name">split.trainsnet.report.form</field>
        <field name="model">split.trainsnet.report</field>
        <field name="arch" type="xml">
            <form string="Trainsnet Delivery Report">
                <group>
                    <field name="date_start"/>
                    <field name="date_end"/>
                </group>
                <footer>
                    <button string="Generate Report" type="object" name="generate_report" class="btn-primary"/>
                    <button string="Close" type="object" name="close_button" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_trainsnet_report" model="ir.actions.act_window">
        <field name="name">Split Delivery Report</field>
        <field name="res_model">split.trainsnet.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_trainsnet_report_action" name="Split shipment report" parent="sale.sale_order_menu"
              sequence="50"
              action="action_trainsnet_report"/>
</odoo>
