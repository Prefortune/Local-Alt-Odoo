<odoo>
    <record id="pf_product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.combo</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='combos']" position="after">
                 <page name="product_bundle" string="Product Bundle" invisible="not detailed_type == 'bundle'">
                    <field name="product_bundle_ids">
                        <tree string="Product Bundle" editable="bottom">                                                           
                            <field name="product_id" />
                            <field name="pf_combo_price" />
                            <field name="pf_qty" />
                            <field name="pf_lst_price"/>
                            <field name="pf_total_price"/>                            
                         </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>