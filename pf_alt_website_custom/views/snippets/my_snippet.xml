<odoo>
<template id="basic_snippet_product" inherit_id="website.snippets" name="product list snippet">
<xpath expr="//div[@id='snippet_effect']//t[@t-snippet][last()]"
               position="after">
            <t t-snippet="pf_alt_website_custom.product_list"/>
</xpath>
</template>
</odoo>