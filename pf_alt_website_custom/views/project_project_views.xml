<odoo>
    <record id="pf_project_view_kanban_inherit_project" model="ir.ui.view">
        <field name="name">pf.project.kanban.inherit.project</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>    
        <field name="arch" type="xml">          
            <xpath expr="//field[@name='activity_ids']" position="after">                         
                    <t t-if="record.sale_order_id.raw_value">
                        <span> <i class="fa fa-dollar"><span></span></i> </span>
                    </t>                
            </xpath>
        </field>
    </record>

     <record model="ir.ui.view" id="view_project_stage_tree_view">
        <field name="name">project.project.stage.tree.inherit</field>
        <field name="model">project.project.stage</field>
        <field name="inherit_id" ref="project.project_project_stage_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="pf_is_approve_stage"></field>
                 <field name="pf_is_in_progress_stage"></field>
            </xpath>
        </field>
</record>

</odoo>
