<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="pf_product_project_form_view" model="ir.ui.view">
        <field name="name">project.product.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
        <xpath expr="//field[@name='tag_ids']" position="after">        
            <field name="product_id"/>
        </xpath>
        </field>
    </record>
 <record id="pf_task_paid_form_view" model="ir.ui.view">
        <field name="name">project.task.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
        <xpath expr="//field[@name='tag_ids']" position="after">
        <field name="is_paid_se"/>
        <field name="product_id"/>
        </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="pf_project_task_kanban_view">
    <field name="name">project.task.kanban.inherit</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_kanban"/>
     <field name="priority">100</field>
    <field name="arch" type="xml">
      <xpath expr="//kanban" position="attributes">
            <attribute name="default_group_by">is_paid_se</attribute>            
    </xpath>             
        <xpath expr="//field[@name='tag_ids']" position="after">
            <div><field name="is_paid_se" widget="badge" decoration-danger="is_paid_se == 'unpaid'" decoration-success="is_paid_se == 'paid'"></field></div>
            <div><field name="product_id"></field></div>
             <div>
            </div>
        </xpath>
    </field>
</record>


