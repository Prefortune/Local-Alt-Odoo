<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">
        <xpath expr="//table[hasclass('o_main_table')]/thead/tr/th[1]" position="before">
            <t t-if="doc.alt_print_image and doc.alt_image_sizes in ('image', 'image_medium', 'image_small')">
                <th style="width:15%;">Product Image</th>
            </t>
        </xpath>
        <xpath expr="//table/tbody[hasclass('sale_tbody')]/t[2]/tr/t/td[1]" position="before">
            <t t-if="doc.alt_image_sizes == 'image' and doc.alt_print_image">
                <td class="text-center">
                    <img t-if="line.product_id.image_1920" t-att-src="image_data_uri(line.product_id.image_1920)" style="max-width:95%;height:auto"/>
                </td>
            </t>
            <t t-if="doc.alt_image_sizes == 'image_medium' and doc.alt_print_image">
                <td class="text-center">
                    <img t-if="line.product_id.image_1920" t-att-src="image_data_uri(line.product_id.image_1920)" style="max-width:70%;height:auto"/>
                </td>
            </t>
            <t t-if="doc.alt_image_sizes == 'image_small' and doc.alt_print_image">
                <td class="text-center">
                    <img t-if="line.product_id.image_1920" t-att-src="image_data_uri(line.product_id.image_1920)" style="max-width:50%;height:auto"/>
                </td>
            </t>
        </xpath>
        
        <!-- Hide summary table in quotations when checkbox is checked -->
        <xpath expr="//div[@name='so_total_summary']" position="attributes">
            <attribute name="t-if">not (doc.state == 'draft' and doc.alt_hide_summary_in_quote)</attribute>
        </xpath>
    </template>

</odoo>
