        </t>
        <!-- </template> -->
    </template>

    <!-- Report Action -->
    <record id="action_report_greeting_card" model="ir.actions.report">
        <field name="name">Greeting Card Report</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">alt_product_image_for_sale.report_greeting_card_document</field>
        <field name="report_file">alt_product_image_for_sale.report_greeting_card_document</field>
        <field name="print_report_name">'Greeting Card - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_greeting_card_a4"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

</odoo>