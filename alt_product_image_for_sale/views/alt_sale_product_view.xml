<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_order_image_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.sale.image</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/kanban/templates/t[@t-name='card']/t[@t-if='!record.display_type.raw_value']/aside" position="inside">
                <field name="alt_image_small" widget="image" options="{'preview_image': 'image_128', 'img_class': 'object-fit-contain w-100'}"/>
            </xpath>
            <field name="payment_term_id" position="before">
                <field name="alt_print_image"/>
                <field name="alt_image_sizes" required="alt_print_image != False"/>
                <field name="alt_hide_summary_in_quote"/>
            </field>
        </field>
    </record>

    <record id="view_order_list_inherit_greeting_card_field" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.alt.product.image.for.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']" position="after">
                <field name="greeting_status" widget="badge"
                        decoration-danger="greeting_status == 'empty'"
                        decoration-info="greeting_status == 'not_printed'"
                        decoration-success="greeting_status == 'printed'"/>

                <field name="picking_status" widget="badge"
                        decoration-info="picking_status == 'not_printed'"
                        decoration-success="picking_status == 'printed'"/>

            </xpath>
        </field>
    </record>

    <record id="view_sale_order_list_inherit_greeting_card_field" model="ir.ui.view">
        <field name="name">view.sale.order.list.inherit.alt.product.image.for.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_list_upload"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="greeting_status" widget="badge"
                        decoration-danger="greeting_status == 'empty'"
                        decoration-info="greeting_status == 'not_printed'"
                        decoration-success="greeting_status == 'printed'"/>

                <field name="picking_status" widget="badge"
                        decoration-info="picking_status == 'not_printed'"
                        decoration-success="picking_status == 'printed'"/>

            </xpath>
        </field>
    </record>

</odoo>
