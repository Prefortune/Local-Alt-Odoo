<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="delivery_route_form_view" model="ir.ui.view">
        <field name="name">delivery.route.form.view</field>
        <field name="model">delivery.route</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="code"/>
                    </group>
                    <group>
                        <field name="name"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="delivery_route_list_view" model="ir.ui.view">
        <field name="name">delivery.route.list.view</field>
        <field name="model">delivery.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_delivery_route_form" model="ir.actions.act_window">
        <field name="name">Delivery Route</field>
        <field name="res_model">delivery.route</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_delivery_route" name="Delivery Route"
              parent="stock.menu_stock_config_settings"
              action="action_delivery_route_form"
              groups="stock.group_stock_manager,stock.group_stock_user"
              sequence="60"/>
</odoo>
