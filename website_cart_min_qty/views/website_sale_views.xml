<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Website Configuration View -->
    <record id="website_config_settings_min_qty" model="ir.ui.view">
        <field name="name">website.config.settings.min.qty</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='ecommerce']" position="inside">
                <div class="app_settings_block" data-string="Minimum Quantity Settings" string="Minimum Quantity Settings">
                    <h2>Minimum Quantity Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="global_min_qty_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="global_min_qty_enabled"/>
                                <div class="text-muted">
                                    Enable global minimum quantity validation for all products
                                </div>
                                <field name="global_min_qty" attrs="{'invisible': [('global_min_qty_enabled', '=', False)]}"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
