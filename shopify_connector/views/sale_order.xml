<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sale_form_inherit" model="ir.ui.view">
            <field name="name">shopify.sale.order.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_term_id']" position="after">       
                    <field name="is_shopify_order"></field>
                    <field name="shopify_order_id"></field>
                    <field name="shopify_store"></field>  
                    <field name="sale_order_tag"></field>
                </xpath> 
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="order_notes"></field>
                </xpath> 
                <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field/tree/field[@name='discount']" position="attributes">
                    <attribute name="groups">product.group_discount_per_so_line</attribute>
                    <attribute name="optional">show</attribute>
                    <attribute name="widget">product_discount</attribute>
                    <attribute name="options">{'digits': (16, 2)}</attribute>
                </xpath>    
                <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field/tree/field[@name='discount']" position="after">
                    <field name="discount_amount"></field>
                </xpath>         
            </field>
        </record>

        <!-- Coupon Program Inherit -->
        <record id="shopify_view_coupon_program_form_inherit" model="ir.ui.view">
            <field name="name">shopify.loyalty.program.inherit</field>
            <field name="model">loyalty.program</field>
            <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="shopify Details" name="shopify_data">
                        <group>
                            <field name="is_shopify_coupon"/>
                            <field name="shopify_coupon_id"/>
                            <field name="shopify_store"/>
                        </group>
                  </page>
                </xpath>
            </field>
        </record>


         <!-- Sale Order Search !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!  -->
         <record id="is_shopify_coupon_search" model="ir.ui.view">
            <field name="name">is_shopify_order.view.search</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
            <field name="arch" type="xml">
              <xpath expr="//filter[@name='sales']" position="after">
                <separator>
                  <filter name="filter_is_shopify_order" string="Shopify Sale Order" domain="[('is_shopify_order', '=', True)]"/>
                </separator>
              </xpath>
            </field>
        </record>

        <!-- Sale Order Action !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!  -->
        <record id="shopify_sale_order_action" model="ir.actions.act_window">
            <field name="name">Shopify Sale Orders</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="sale.sale_order_view_search_inherit_quotation"/> <!-- This is the standard tree view for sale orders -->
            <field name="context">{'search_default_is_shopify_order': 1}</field>
            <field name="target">current</field>
        </record>
        
        <menuitem
          id="shopify_sale_order"
          name="Shopity Sale Order"
          parent = "shopify_odoo_root_menu"
          action = "shopify_sale_order_action"
          sequence="1"/>

    </data>
</odoo>
