<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payplus_account_move_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="after">
                <button name="action_refund_payplus" string="Refund PayPlus" type="object" class="btn btn-primary" invisible="not is_refund_button"/>
            </xpath>
            <xpath expr="//field[@name='narration']" position="before">
                <field name="payplus_transaction_id" readonly="1" invisible="not payplus_transaction_id"/>
                <field name="payment_provider_id" readonly="1" invisible="not payment_provider_id"/>
            </xpath>
        </field>
    </record>

    <record id="sales_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info" invisible="not is_warning_div">
                    <strong> שימו לב: </strong>
                    <p>
                         הזמנה זו שולמה באמצעות אמצעי התשלום J5. בשלב זה, רק מסגרת האשראי נשמרה – החיוב בפועל יושלם רק לאחר שליחת ההזמנה והנפקת החשבונית.
                    </p> 
                </div>
            </xpath>
        </field>
    </record>

</odoo>
