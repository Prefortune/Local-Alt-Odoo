<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_payplus_refund" model="ir.actions.server">
        <field name="name">PayPlus Refund</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">action</field> <!-- shows in Action dropdown -->
        <field name="state">code</field>
        <field name="code">
            action = records.action_payplus_refund()
        </field>
    </record>
    <record id="view_order_form_inherit_ribbon" model="ir.ui.view">
        <field name="name">sale.order.form.ribbon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="In Payment" invisible="payplus_payment_status != 'in_payment'"/>
                <widget name="web_ribbon" title="Paid" invisible="payplus_payment_status != 'paid'"/>
                <widget name="web_ribbon" title="Not Paid" invisible="payplus_payment_status != 'not_paid'"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_show_transactions" invisible="transaction_count &lt; 1" icon="fa-credit-card">
                    <field name="transaction_count" widget="statinfo" string="Transactions"/>
                </button>
            </xpath>

            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="approve_j5_order" type="object" string="Approve J5 Payment" invisible="not is_warning_div" groups="account.group_account_manager"/>
            </xpath>

            <xpath expr="//field[@name='note']" position="after">
                <field name="transaction_number" string="Payplus Transaction Number" invisible="not transaction_number" readonly="1"/>
            </xpath>

        </field>
    </record>
</odoo>