<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_size_chart_tree" model="ir.ui.view">
            <field name="name">size.chart.tree</field>
            <field name="model">pf.size.chart</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" string="Size Chart Name"/>
                    <field name="pf_date"/>
                    <field name="pf_invoice"/>
                    <field name="partner_id"/>
                    <field name="pf_target_date"/>
                    <field name="pf_status"/>
                    <field name="pf_model"/>
                    <field name="pf_fabric"/>
                    <field name="pf_body_size"/>
                    <field name="pf_length"/>
                    <field name="pf_shoulder"/>
                    <field name="pf_sleeves"/>
                    <field name="pf_underarm"/>
                    <field name="pf_chest"/>
                    <field name="pf_hips"/>
                    <field name="pf_waist"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_size_chart_form" model="ir.ui.view">
            <field name="name">size.chart.form</field>
            <field name="model">pf.size.chart</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="pf_date"/>
                                <field name="pf_invoice"/>
                                <field name="partner_id"/>
                                <field name="pf_target_date"/>
                                <field name="pf_status"/>
                                <field name="pf_model"/>
                                <field name="pf_new_alter"/>
                            </group>
                            <group>
                                <field name="pf_fabric"/>
                                <field name="pf_sleeves"/>
                                <field name="pf_collar"/>
                                <field name="pf_closing"/>
                                <field name="pf_belt"/>
                                <field name="pf_shella"/>
                                <field name="pf_body_size"/>
                                <field name="pf_note"/>
                            </group>                                                      
                        </group>
                        <group string="Measurements">
                            <field name="pf_length"/>
                            <field name="pf_shoulder"/>
                            <field name="pf_sleeves"/>
                            <field name="pf_underarm"/>
                            <field name="pf_upperarm"/>
                            <field name="pf_chest"/>
                            <field name="pf_hips"/>
                            <field name="pf_waist"/>
                            <field name="pf_pocket_height"/>
                        </group>
                        <notebook>
                            <page string="Size Chart Lines">
                                <field name="size_chart_line_ids" widget="one2many_list">
                                    <tree editable="bottom">
                                        <field name="size_chart_id"/>
                                        <field name="pf_model"/> 
                                        <field name="quantity"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
         <record id="view_size_chart_line_tree" model="ir.ui.view">
            <field name="name">size.chart.line.tree</field>
            <field name="model">pf.size.chart.line</field>
            <field name="arch" type="xml">
                <tree>
                    <!-- <field name="name"/> -->
                    <field name="size_chart_id"/>
                     <field name="pf_model"/>   
                    <field name="quantity"/>
                </tree>
            </field>
        </record>
        <record id="view_size_chart_tree_custom" model="ir.ui.view">
            <field name="name">pf.size.chart.tree.custom</field>
            <field name="model">pf.size.chart</field>
            <field name="arch" type="xml">
                <tree string="Size Charts">
                    <field name="name"  string="Size Chart Name"/>
                    <field name="pf_model"/>                    
                    <!-- <button name="action_view_order_lines" type="object" string="View Lines" class="btn-primary"> -->
                        <field name="total_quantity" options="{'clickable': '1'}"></field>
                    <!-- </button> -->
                </tree>
            </field>
        </record>
                
        <!-- Action -->
        <record id="action_size_chart" model="ir.actions.act_window">
            <field name="name">Size Chart</field>
            <field name="res_model">pf.size.chart</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="pf_action_view_size_chart_lines" model="ir.actions.act_window">
            <field name="name">Size Chart Lines</field>
            <field name="res_model">pf.size.chart.line</field>
            <field name="view_mode">tree</field>            
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_size_chart_root" name="Size Chart"/>
        <menuitem id="menu_size_chart" parent="menu_size_chart_root" name="Size Charts" action="action_size_chart"/>
    </data>
</odoo>
