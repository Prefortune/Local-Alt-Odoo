<odoo>   
    <!-- Sale Order Line View -->
    <record id="view_order_form_inherit_size_chart" model="ir.ui.view">
        <field name="name">sale.order.line.size.chart</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree" position="inside">               
                <field name="pf_size_chart_line_ids" widget="many2many_tags" context="{'default_sale_order_line_id': active_id}"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form" position="inside">               
                <field name="pf_size_chart_line_ids" widget="many2many_tags" context="{'default_sale_order_line_id': active_id}"/>
            </xpath>
        </field>
    </record>       
</odoo>