<record id="view_shopify_store_form" model="ir.ui.view">
    <field name="name">shopify.connect.form</field>
    <field name="model">shopify.connector</field>
    <field name="arch" type="xml">
        <form string="Shopify Store">
            <sheet>
                <!-- General Information Page -->
                <group>
                    <group>
                        <field name="name" />
                        <field name="shopify_shop_name" />
                        <field name="shopify_api_key" />
                        <field name="shopify_access_token" />
                        <field name="shopify_api_secret_key" />
                    </group>
                    <group>
                        <field name="shopify_url" readonly="1" />
                        <field name="shopify_webhook_version" />
                        <field name="shopify_connection_status" readonly="1" />
                        <field name="currency_id" />
                        <field name="store_price_list" readonly="1" />
                        <field name="is_price_list_require" invisible="1" />
                    </group>
                </group>

                <notebook>
                    <!-- Webhook Setup Page -->
                    <page string="Configuration">
                        <group>
                            <group>
                                <field name="force_accounting_date" />
                                <field name="sale_journal" />
                            </group>
                            <group>
                                <field name="payment_journal" />
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                            </group>
                        </group>
                    </page>
                    <page string="Webhook Setup">
                        <group>
                            <group>
                                <field name="enable_product_webhook" />
                                <field name="enable_customer_webhook" />
                                <field name="product_create_webhook" readonly="1" groups="base.group_no_one" />
                                <field name="product_update_webhook" readonly="1" groups="base.group_no_one" />
                                <field name="customer_create_webhook" readonly="1" groups="base.group_no_one" />
                                <field name="customer_update_webhook" readonly="1" groups="base.group_no_one" />
                            </group>
                            <group>
                                <field name="enable_coupen_webhook" />
                                <field name="coupen_create_webhook" readonly="1" groups="base.group_no_one" />
                                <field name="coupen_update_webhook" readonly="1" groups="base.group_no_one" />
                                <field name="order_create_webhook" readonly="1" groups="base.group_no_one" />
                                <field name="order_update_webhook" readonly="1" groups="base.group_no_one" />
                            </group>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>


<record id="action_shopify_odoo_connect" model="ir.actions.act_window">
    <field name="name">Shopify Odoo Connector</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">shopify.connector</field>
    <field name="view_mode">tree,kanban,form</field> 
    <field name="context">{}</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            create a Store!!!!!!
        </p>
    </field>
</record>

<record id="view_shopify_connector_tree" model="ir.ui.view">
    <field name="name">shopify.connect.tree</field>
    <field name="model">shopify.connector</field>
    <field name="arch" type="xml">
        <tree>
            <field name="name"/>
            <field name="shopify_shop_name"/>
            <field name="shopify_connection_status" decoration-danger="shopify_connection_status == 'Connection Failed'" decoration-success="shopify_connection_status == 'Connection success'" widget="badge"/>
            <button name="test_shopify_connection" string="Test Connection" type="object" class="oe_highlight"/>
            <button name="prepare_product_queue" string="Product Sync" type="object" class="oe_highlight"/>
            <button name="prepare_customer_queue" string="Customer Sync" type="object" class="oe_highlight"/>
            <button name="prepare_order_queue" string="Order Sync" type="object" class="oe_highlight"/>
            <button name="import_shopify_coupon" string="Coupon Sync" type="object" class="oe_highlight"/>
            <button name="cron_subscription" string="Cron subscription" type="object" class="oe_highlight"/>
<!--             <button name="import_shopify_order_by_id" string="Sync product specific" type="object" class="oe_highlight"/> -->
        </tree>
    </field>
</record>

<menuitem
    id="shopify_connect"
    name="Store Manage"
    parent = "store_management"
    action = "action_shopify_odoo_connect"
    sequence="1"/>

</odoo>
