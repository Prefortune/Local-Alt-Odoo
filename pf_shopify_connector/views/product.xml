<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Product Temp -->
        <record id="view_shopify_product_template_form_inherit" model="ir.ui.view">
            <field name="name">shopify.product.template.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='detailed_type']" position="after">       
                    <field name="is_shopify_product"></field>   
                </xpath>
                <xpath expr="//field[@name='is_shopify_product']" position="after">       
                    <field name="shopify_store"/>
                </xpath>
                <xpath expr="//field[@name='shopify_store']" position="after">       
                    <field name="shopify_product_id"/>
                    <field name="shopify_qraphql_product_id"/>
                </xpath>           
            </field>
        </record>
        <!-- product product -->
        <record id="view_shopify_product_product_image_inherit" model="ir.ui.view">
            <field name="name">shopify.product.product.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_policy']" position="after">       
                    <field name="shopify_product_id"></field>
                    <field name="shopify_qraphql_product_id"/>
                    <field name="shopify_qraphql_product_variant_id"></field>
                    <field name="shopify_variant_id"></field> 
                    <field name="shopify_store"></field>
                </xpath>              
            </field>
        </record>

        <record id="view_shopify_product_product_variant_inherit" model="ir.ui.view">
            <field name="name">shopify.product.variant.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='pricing']" position="inside">       
                    <field name="custom_price_extra"></field>
                </xpath>              
            </field>
        </record>

    </data>
</odoo>