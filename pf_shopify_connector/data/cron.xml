<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Product Sync Cron -->
        <record id="sync_product_auto" model="ir.cron">
            <field name="name">Shopify Odoo Product Cron</field>
            <field name="active" eval="True"></field>
            <field name="priority">10</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <!-- <field name="nextcall" eval="(datetime.utcnow() + timedelta(days=0)).strftime('%Y-%m-%d 12:01:00')"/> -->
            <field name="model_id" ref="model_shopify_sync_queue"/>
            <field name="state">code</field>
            <field name="code">model.sync_product_cron()</field>
        </record>
        
        <!-- Customer Sync Cron -->
        <record id="sync_customer_auto" model="ir.cron">
            <field name="name">Shopify Odoo Customer Cron</field>
            <field name="active" eval="True"></field>
            <field name="priority">10</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <!-- <field name="nextcall" eval="(datetime.utcnow() + timedelta(days=0)).strftime('%Y-%m-%d 12:01:00')"/> -->
            <field name="model_id" ref="model_shopify_sync_queue"/>
            <field name="state">code</field>
            <field name="code">model.sync_customer_cron()</field>
        </record>

        <!-- Order Sync Cron -->
        <record id="sync_order_auto" model="ir.cron">
            <field name="name">Shopify Odoo Order Cron</field>
            <field name="active" eval="True"></field>
            <field name="priority">10</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <!-- <field name="nextcall" eval="(datetime.utcnow() + timedelta(days=0)).strftime('%Y-%m-%d 12:01:00')"/> -->
            <field name="model_id" ref="model_shopify_sync_queue"/>
            <field name="state">code</field>
            <field name="code">model.sync_order_cron()</field>
        </record>


    </data>
</odoo>

