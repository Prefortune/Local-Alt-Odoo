<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="product_template_form_view">
        <field name="name">product.template</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view" />
        <field name="arch" type="xml">
            <field name="website_id" position="after">
                <field name="website_ids" options="{'no_create': True}" groups="website.group_multi_website" widget="many2many_tags" />
            </field>
        </field>
    </record>
    <record model="ir.ui.view" id="product_template_tree_view">
        <field name="name">product.template</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_view_tree" />
        <field name="arch" type="xml">
            <field name="website_id" position="after">
                <field name="website_ids" options="{'no_create': True}" groups="website.group_multi_website" widget="many2many_tags" optional="hide" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="product_template_form_view_inherit_add_group">
        <field name="name">product.template</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website_id']" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="product_varients_form_view_inherit_add_group">
        <field name="name">product.product</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website_id']" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
        </field>
    </record>

</odoo>

