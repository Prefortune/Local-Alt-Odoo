<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="account_invoice_form_bills">
        <field name="name">Account.bill.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>
            <xpath expr="//div[@name='journal_div']/field[@name='journal_id']"
                   position="attributes">
                <attribute name="groups"> </attribute>
            </xpath>
            <xpath expr="//div[@name='journal_div']/field[@name='journal_id']"
                   position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_limit']" position="attributes">
                <attribute name="groups">account.group_account_manager
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>