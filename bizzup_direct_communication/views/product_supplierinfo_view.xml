<?xml version="1.0" encoding="UTF-8"?>
<odoo>
     <record id="view_product_supplierinfo_form_inherit" model="ir.ui.view">
        <field name="name">product.template.product.form.inherit</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
          <xpath expr="//field[@name='partner_id']" position="after">
              <field name="direct_communication"/>
          </xpath>
        </field>
    </record>

     <record id="view_product_supplierinfo_form_field_inherit" model="ir.ui.view">
        <field name="name">product.template.product.form.field.inherit</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">
          <xpath expr="//field[@name='product_code']" position="after">
              <field name="direct_communication"/>
          </xpath>
        </field>
    </record>
</odoo>
