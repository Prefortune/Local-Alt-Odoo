<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="bizzup_pos_tranzila_connect.CreatePaymentPopupWidget">
        <Dialog title="props.title" size="'md'">
            <t t-set-slot="header">
                <h4 class="modal-title title" t-esc="props.title"/>
            </t>
            <div t-ref="root">
                <table style="width: 81%; border-collapse: collapse; margin-top: 45px;">
                    <tr>
                        <td style="padding: 7px; vertical-align: top;">
                            <label class="col-form-label" style="margin-left: 73px;">POS ID :</label>
                        </td>
                        <td style="margin-left:50px; padding: 10px;">
                            <select t-model="this.props.selectedTerminal" class="form-control">
                                <option value="">Select a machine ID</option>
                                <t t-foreach="this.props.order_ref" t-as="terminal" t-key="terminal.id">
                                    <option t-att-value="terminal.id"
                                            t-att-selected="terminal.id === this.props.selectedTerminal">
                                        <t t-esc="terminal.name"/>
                                    </option>
                                </t>
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 7px; vertical-align: top;">
                            <label class="col-form-label" style="margin-left: 73px;">Payment Limit :</label>
                        </td>
                        <td style="margin-left:50px; padding: 10px;">
                            <select t-model="this.props.selectedLimit" class="form-control">
                                <t t-foreach="Array.from({ length: this.props.paymentlimit }, (v, k) => k + 1)"
                                   t-as="limit" t-key="limit">
                                    <option t-att-value="limit">
                                        <t t-esc="limit"/>
                                    </option>
                                </t>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 7px; vertical-align: top;">
                            <label class="col-form-label" style="margin-left: 73px;">Amount :</label>
                        </td>
                        <td style="margin-left:50px; padding: 10px;">
                            <t t-esc="this.props.amount"/>
                        </td>
                    </tr>
                </table>
            </div>

            <t t-set-slot="footer">
                <div class="d-flex flex-grow-1 justify-content-center">
                    <button style="margin-right: 10px;" class="btn btn-lg btn-primary" t-on-click="confirm" t-esc="props.confirmLabel" />
                    <button class="btn btn-secondary btn-lg lh-lg o-default-button"
                            tabindex="1" t-on-click="close" t-esc="props.cancelLabel"/>
                </div>
            </t>
       </Dialog>
    </t>
</templates>

