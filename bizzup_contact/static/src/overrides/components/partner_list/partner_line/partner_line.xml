<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="bizzup_contact.PartnerLine" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//span[@t-if='this.partnerInfos.totalDue > 0']" position="replace">
            <t t-if="this.partnerInfos.totalDue > 0 or this.partnerInfos.totalDue != 0">
                Total due: <t t-esc="env.utils.formatCurrency(this.partnerInfos.totalDue)"/>
            </t>
        </xpath>
    </t>
 </templates>
