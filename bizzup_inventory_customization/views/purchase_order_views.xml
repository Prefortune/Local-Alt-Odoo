<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_order_line_form_view_inherit_category" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.category</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_confirm' and @id='bid_confirm']" position="attributes">
                <attribute name="context">{'validate_analytic': True,'restrict_access': True}</attribute>
            </xpath>
            <xpath expr="//button[@name='button_confirm' and @id='draft_confirm']" position="attributes">
                <attribute name="context">{'validate_analytic': True,'restrict_access': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
