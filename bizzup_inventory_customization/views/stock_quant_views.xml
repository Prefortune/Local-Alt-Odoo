<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_tree_inventory_access" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable.inherit.access</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_apply_inventory']" position="attributes">
                <attribute name="context">{'is_inventory_adjustment': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='inventory_diff_quantity']" position="after">
                <field name="cost_gap" string="Cost Gap"/>
                <field name="value" widget='monetary' options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
