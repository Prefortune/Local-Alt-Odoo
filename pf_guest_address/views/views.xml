                    </div>
                    <input id="o_email" type="email" name="email" class="form-control" t-att-value="partner_sudo.email" />
                </div>
                <!-- <h4 class="mb-1 mt-5">Fill in your Billing Address</h4> -->
                <h4 class="fs-6 small text-uppercase fw-bolder mb-2" id="shipping_address_label">fill in your shipping address ? </h4>
                <div class="form-check mt-4" id="fill_address_div">
                    <!-- <input type="checkbox" class="form-check-input" id="want_fill_above_data" name="want_fill_above_data" checked="checked"/> -->
                    <input type="checkbox" class="form-check-input" id="want_fill_above_data" name="want_fill_above_data" />
                    <label class="form-check-label" for="want_fill_above_data">
                        Want to Fill Above Data ?
                    </label>
                </div>
            </t>
