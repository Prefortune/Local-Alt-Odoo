<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_website_sale_address_billing_form" inherit_id="website_sale.address" name="Website Sale Address with Billing for Anonymous">
        <!-- Inject Billing Address after default delivery address form -->
        <xpath expr="//t[@t-if='is_anonymous_cart']" position="replace">
            <t t-if="is_anonymous_cart">
                <h4 class="fs-6 small text-uppercase fw-bolder">Personal Details</h4>
                <div class="list-group mb-4 list-group-item pb-2">
                    <div class="card-body mb-2">
                        <!-- Full Name -->
                        <div class="mb-3">
                            <label class="form-label fw-medium" for="personal_name">Full Name</label>
                            <input type="text" name="personal_name" id="personal_name" class="form-control" required="required"/>
                        </div>
                        <!-- Email & Phone -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-medium" for="personal_email">Email</label>
                                <input type="email" name="personal_email" id="personal_email" class="form-control" required="required"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium" for="personal_phone">Phone</label>
                                <input type="text" name="personal_phone" id="personal_phone" class="form-control" required="required"/>
                            </div>
                        </div>
                        <!-- Company & VAT -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-medium" for="personal_company">Company Name</label>
                                <input type="text" name="personal_company" id="personal_company" class="form-control"  required="required"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-medium" for="personal_vat">VAT</label>
                                <input type="text" name="personal_vat" id="personal_vat" class="form-control" required="required"/>
                            </div>
                        </div>
                    </div>
                </div>
