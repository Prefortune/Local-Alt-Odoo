<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Security Groups -->
        <record id="group_alt_searchbar_admin" model="res.groups">
            <field name="name">Searchbar Administrator</field>
            <field name="category_id" ref="base.module_category_website"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="alt_searchbar_config_rule" model="ir.rule">
            <field name="name">Searchbar Config: Admin Access</field>
            <field name="model_id" ref="model_alt_searchbar_config"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_alt_searchbar_admin'))]"/>
        </record>

        <!-- Public Access Rule -->
        <record id="alt_searchbar_config_public_rule" model="ir.rule">
            <field name="name">Searchbar Config: Public Read Access</field>
            <field name="model_id" ref="model_alt_searchbar_config"/>
            <field name="domain_force">[('is_active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_public'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo> 