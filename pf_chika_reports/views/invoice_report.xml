<odoo>
    <template id="report_invoice_document_pf_inherit" inherit_id="account.report_invoice_document">
        <!-- REMOVE HEADER/FOOTER -->
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="pf_chika_reports.custom_standard_external_layout">
                <span>
                    <t t-set="o" t-value="o.with_context(report_name='INV')"/>
                </span>
                <!-- <xpath expr="//t[@t-call='web.external_layout']" position="replace"> -->
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <t t-set="company" t-value="company_id or request.env.user.company_id"/>
                <t t-set="lang" t-value="o.partner_id.lang or 'en_US'"/>
                <div class="page" style="border: 2px solid #000;">
                    <div class="row mt-4 pad_5">
                        <div class="col-6">
                            <strong t-esc="o.company_id.name"/>
                            <br/>
                            <span t-esc="o.company_id.street"/>
                            <br/>
                            <span t-if="o.company_id.street2" t-esc="o.company_id.street2"/>
                            <br/>
                            <span t-esc="o.company_id.city"/>
                            <span t-esc="o.company_id.zip"/>
                            <br/>
                            <span t-esc="o.company_id.country_id.name"/>
                        </div>
                        <div class="col-6 text-end">
                            <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 45px;" alt="Logo"/>
                        </div>
                    </div>
                    <div class="text-center" style="border-top: 2px solid black; border-bottom: 2px solid black;">
                        <t t-if="o.invoice_filter_type_domain != 'purchase'">
                            <span>
                            TAX INVOICE
                            </span>
                        </t>
                        <t t-else="">
                            <span>
                            VENDOR BILL
                            </span>
                        </t>
                    </div>
                    <div class="row mb-3 pad_5">
                        <div class="col-6">
                            <strong>Bill To:</strong>
                            <br/>
                            <span t-esc="o.partner_id.name"/>
                            <br/>
                            <span t-esc="o.partner_id.street"/>
                            <br/>
                            <span t-if="o.partner_id.street2" t-esc="o.partner_id.street2"/>
                            <br/>
                            <span t-esc="o.partner_id.city"/>
                            <span t-esc="o.partner_id.zip"/>
                            <br/>
                            <span t-esc="o.partner_id.country_id.name"/>
                            <br/>
                            <t t-if="o.partner_id.vat">
                    Customer TRN:
                                <span t-esc="o.partner_id.vat"/>
                            </t>
                        </div>
                        <div class="col-6 text-end">
                    Invoice No.:
                            <span t-esc="o.name"/>
                            <br/>
                    Date:
                            <span t-field="o.invoice_date"/>
                            <br/>
                    Reference No:
                            <span t-esc="o.ref or ''"/>
                            <br/>
                    Our TRN:
                            <span t-esc="o.company_id.vat or ''"/>
                            <br/>
                    Location:
                            <span t-esc="o.company_id.city"/>
                        </div>
                    </div>
                    <!-- PRODUCT TABLE -->
                    <table class="table">
                        <thead >
                            <tr>
                                <th>#</th>
                                <th class="text-left">Item &amp; Description</th>
                                <th class="text-center">Qty</th>
                                <th class="text-center">VAT%</th>
                                <th class="text-center">Rate</th>
                                <th class="text-center">Tax</th>
                                <th class="text-center">Amount</th>
                            </tr>
                        </thead>
                        <tbody class="custom_color">
                            <t t-set="count" t-value="0"/>
                            <tr t-foreach="o.invoice_line_ids" t-as="line" t-foreach-index="i">
                                <t t-set="count" t-value="count + 1"/>
                                <td class="text-center">
                                    <span><t t-esc="count"/></span>
                                </td>
                                <td>
                                    <span t-esc="line.name"/>
                                </td>
                                <td class="text-center">
                                    <span t-out="int(line.quantity)"/>
                                </td>
                                <td class="text-center">
                                    <span t-field="line.tax_ids"/>
                                </td>
                                <td class="text-end">
                                    <t t-if="line.price_unit">
                                        <span t-out="o.currency_id.name + ' ' + '%.2f' % line.price_unit"/>
                                    </t>
                                    <t t-else="">
                                        <span>-</span>
                                    </t>
                                    <!-- <div class="row">
                                        <div class="col-6 text-start">
                                            <span t-esc="o.currency_id.name"/>
                                        </div>
                                        <div class="col-6 text-end">
                                            <t t-if="tax_amt">
                                                <span t-esc="line.price_unit"/>
                                            </t>
                                            <t t-else="">
                                                <span>-</span>
                                            </t>
                                        </div>
                                    </div> -->
                                </td>
                                <td class="text-end">
                                    <t t-set="tax_amt" t-value="line.price_total - line.price_subtotal"/>
                                    <t t-if="tax_amt">
                                        <span t-out="o.currency_id.name + ' ' + '%.2f' % tax_amt"/>
                                    </t>
                                    <t t-else="">
                                        <span>-</span>
                                    </t>
                                    <!-- <div class="row">
                                        <div class="col-6 text-start">
                                            <span t-esc="o.currency_id.name"/>
                                        </div>
                                        <div class="col-6 text-end">
                                            <t t-if="tax_amt is not None">
                                                <span t-out="'%.2f' % tax_amt"/>
                                            </t>
                                            <t t-else="">
                                                <span>-</span>
                                            </t>
                                        </div>
                                    </div> -->
                                </td>
                                <td class="text-end">
                                    <t t-set="amt" t-value="line.price_total"/>
                                    <span t-out="o.currency_id.name + ' ' + '%.2f' % amt"/>
                                    <!-- <div class="row nowrap">
                                        <div class="col-6 text-start">
                                            <span t-esc="o.currency_id.name"/>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span t-esc="amt"/>
                                        </div>
                                    </div> -->
                                </td>
                            </tr>
                        </tbody>
                        <tbody class="body_end">
                            <tr>
                                <td colspan="4" class="text-start">
                                    <span>TOTAL:</span>
                                </td>
                                <td class="text-end">
                                    <span t-out="o.currency_id.name + ' ' + '%.2f' % o.amount_untaxed"/>
                                    <!-- <div class="row">
                                            <div class="col-6 text-start">
                                                <span t-esc="o.currency_id.name"/>
                                            </div>
                                            <div class="col-6 text-end">
                                                <span t-esc="o.amount_untaxed"/>
                                            </div>
                                        </div> -->
                                </td>
                                <td class="text-end">
                                    <t t-set="tax_total" t-value="o.amount_total - o.amount_untaxed"/>
                                    <t t-if="tax_total is not None">
                                        <span t-out="o.currency_id.name + ' ' + '%.2f' % tax_total"/>
                                    </t>
                                    <t t-else="">
                                        <span>-</span>
                                    </t>
                                    <!-- <div class="row">
                                            <div class="col-6 text-start">
                                                <span t-esc="o.currency_id.name"/>
                                            </div>
                                            <div class="col-6 text-end">
                                                <t t-set="tax_total" t-value="o.amount_total - o.amount_untaxed"/>
                                                <t t-if="tax_total is not None">
                                                    <span t-out="'%.2f' % tax_total"/>
                                                </t>
                                                <t t-else="">
                                                    <span>-</span>
                                                </t>
                                            </div>
                                        </div> -->
                                </td>
                                <td class="text-end">
                                    <span t-out="o.currency_id.name + ' ' + '%.2f' % o.amount_total"/>
                                    <!-- <div class="row">
                                            <div class="col-6 text-start">
                                                <span t-esc="o.currency_id.name"/>
                                            </div>
                                            <div class="col-6 text-end">
                                                <span t-esc="o.amount_total"/>
                                            </div>
                                        </div> -->
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="text_border">
                        <!-- <span>Amount Due: </span> -->
                        <t t-if="o.payment_state != 'invoicing_legacy'">
                            <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                            <t t-if="len(payments_vals) > 0">
                                <tr class="border-black fw-bold">
                                    <td>Amount Due : </td>
                                    <td class="text-end">
                                        <span t-field="o.amount_residual">11.05</span>
                                    </td>
                                </tr>
                            </t>
                            <br/>
                            <t t-foreach="payments_vals" t-as="payment_vals">
                                <tr t-if="payment_vals['is_exchange'] == 0">
                                    <td>
                                        <i class="oe_form_field text-end oe_payment_label">Paid on
                                            <t t-out="payment_vals['date']" t-options='{"widget": "date"}'>2021-09-19</t> : 
                                        </i>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'>20.00</span>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </div>
                    <div>
                        <div class="text_border">
                            <t t-set="tax_amount" t-value="o.amount_tax"/>
                            <t t-set="tax_amount_words" t-value="o.currency_id.amount_to_text(tax_amount)"/>
                            <span>VAT Payable
                                <span t-esc="o.currency_id.name"/>:
                                <span t-esc="tax_amount_words"/></span>
                        </div>
                        <div class="text_border">
                            <span>TOTAL
                                <span t-esc="o.currency_id.name"/>:
                                <span t-field="o.amount_total_words"/></span>
                        </div>
                        <div class="spacing"></div>
                        <div class="condtions">
                            <span>Make all checks payable to "AL GHAFF ARTEFACTS TRADING LLC" or remit the amount into the below mentioned account.</span>
                        </div>
                        <div class="pad_5">
                            <div>
                                <span>Beneficiary: AL GHAFF ARTEFACTS TRADING LLC</span>
                            </div>
                            <div>
                                <span>Beneficiary Address: PO Box 393380 Dubai UAE</span>
                            </div>
                            <div>
                                <span>AED Account Number: 1014984790101</span>
                            </div>
                            <div>
                                <span>IBAN: AE290260001014984790101</span>
                            </div>
                            <div>
                                <span>Swift Code: EBILAEAD</span>
                            </div>
                            <div>
                                <span>Bank: Emirates NBD Bank</span>
                            </div>
                            <div>
                                <span>Branch: Jumeirah Branch</span>
                            </div>
                            <div>
                                <span>Bank Address: PO Box 777 Dubai UAE</span>
                            </div>
                        </div>
                        <t t-if="o.narration">
                            <div class="spacing"></div>
                            <div class="text_narration">
                                <t t-esc="o.narration"/>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>