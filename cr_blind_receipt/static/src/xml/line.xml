<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<template t-name="cr_blind_receipt.LineQuantityy" t-inherit="stock_barcode.LineQuantity" t-inherit-mode="extension">
    <xpath expr="//div[@name='quantity']" position="replace">
        <span t-attf-class="o_barcode_scanner_qty font-monospace fs-1">
            <span class="qty-done" t-if="! state.blind_receipt  and  !state.is_loading"
                t-attf-class="
                    {{nextExpected === 'quantity'  &amp;&amp;qtyDone ? 'o_flash' : ''}}
                    {{qtyDemand  &amp;&amp; qtyDone == 0 ? env.model.zeroQtyClass(line) : ''}}
                    {{qtyDemand  &amp;&amp; qtyDone  &amp;&amp; qtyDone == qtyDemand ? 'text-success' : ''}}"
                t-out="env.model.IsNotSet(line) ? '?' : qtyDone"/>
            
            <span class="qty-done" t-if="state.blind_receipt and  !state.is_loading"
                t-attf-class="
                    {{nextExpected === 'quantity'  &amp;&amp; qtyDone ? 'o_flash' : ''}}
                    {{qtyDemand  &amp;&amp; qtyDone == 0 ? env.model.zeroQtyClass(line) : ''}}"
                t-out="env.model.IsNotSet(line) ? '?' : qtyDone"/>
            
            <t t-if="!state.is_loading and env.model.displayLineQtyDemand(line)">
            <t t-if="state.blind_receipt">
                /?
            </t>
            <t t-else="">
                <span t-out="'/' + qtyDemand"/>
            </t>
        </t>

        </span>
        
        <small t-if="props.displayUOM" class="o_line_uom text-muted ms-1"
            t-out="props.line.product_uom_id.name"/>
    </xpath>
</template>

    <template  t-name="cr_blind_receipt.LineQuantity"  t-inherit="stock_barcode.LineLowerButtons"  t-inherit-mode="extension" >
    <xpath expr="//div[@t-else]" position="replace">
        <div  class="d-flex flex-nowrap gap-2">
            <button class="o_line_button btn px-0" style="min-width:0"/>

            <button t-if="isSelected &amp;&amp; env.model.toggleAsCounted" t-on-click="toggleAsCounted"
                    t-attf-class="o_line_button btn btn-{{quantityIsSet ? 'warning o_unset' : 'danger o_count_zero'}}">
                <span t-if="quantityIsSet" class="fa fa-lg fa-question"/>
                <span t-else="">0</span>
            </button>
            <button t-if="isSelected &amp;&amp; qtyDone" name="decrementButton"
                    class="o_line_button o_remove_unit btn btn-light"
                    t-att-disabled="!this.env.model.lineCanBeEdited(line)"
                    t-on-click="() => this.addQuantity(-1)">
                -1
            </button>
            <button t-if="displayIncrementButton" name="incrementButton"
                    class="o_line_button o_add_quantity btn btn-light"
                    t-att-disabled="!this.env.model.lineCanBeEdited(line)"
                    t-on-click="() => this.addQuantity(1)">+1</button>
           <button t-if="displayFulfillbutton &amp;&amp; ! state.blind_receipt   &amp;&amp;  !state.is_loading" name="fulfillButton"
                    t-on-click="() => this.addQuantity(incrementQty)"
                    t-att-disabled="!this.env.model.lineCanBeEdited(line)"
                    t-attf-class="o_line_button o_add_remaining_quantity btn btn-{{isSelected ? 'light' : 'secondary'}}">
                <t t-if="incrementQty > 0">+</t><t t-esc="incrementQty"/>
            </button>

            <button t-if="displayDeleteButton" name="deleteButton"
                    t-on-click="() => this.env.model.deleteLine(line)"
                    t-att-disabled="!this.env.model.lineCanBeEdited(line)"
                    class="o_line_button o_delete_line btn btn-danger">
                <span class="fa fa-lg fa-trash"/>
            </button>
        </div>
    </xpath>
</template>

    <template  t-name="cr_blind_receipt.DigipadTemplate"  t-inherit="stock_barcode.DigipadTemplate"  t-inherit-mode="extension" >
        <xpath expr="//div[contains(@class, 'o_digipad_digit_buttons')]" position="replace">
                <div class="o_digipad_digit_buttons row g-2">
                    <div t-att-class="buttonContainerClass">
                        <button t-on-click="erase" t-att-disabled="quantity &lt;= 0" class="o_digipad_erase btn btn-secondary w-100">0</button>
                    </div>
                    <div t-att-class="buttonContainerClass">
                        <button t-on-click="decrement" t-att-disabled="quantity &lt;= 0" class="o_digipad_decrement btn btn-secondary w-100">-1</button>
                    </div>
                    <div t-att-class="buttonContainerClass">
                        <button t-on-click="increment" class="o_digipad_increment btn btn-secondary w-100">+1</button>
                    </div>
                    <div t-if="!state.blind_receipt &amp;&amp;  !state.is_loading &amp;&amp; fulfillQuantity" class="col-3">
                        <button t-on-click="fulfill"
                                class="o_digipad_fufill w-100 btn"
                                t-att-class="buttonFulfillClass">
                            <t t-if="quantityToFulfill &gt; 0" t-esc="'+' + quantityToFulfill"/>
                            <t t-elif="quantityToFulfill &lt; 0" t-esc="quantityToFulfill"/>
                            <span t-else="" class="fa fa-lg fa-check"/>
                        </button>
                    </div>

                    <t t-foreach="state.packagingButtons" t-as="packaging" t-key="packaging.id">
                        <div class="col-6">
                            <button t-on-click="() => this._increment(packaging.qty, this.quantity === 1)"
                                    class="btn btn-secondary w-100" t-out="packaging.name"/>
                        </div>
                    </t>
                </div>
            </xpath>
    </template>

</odoo>