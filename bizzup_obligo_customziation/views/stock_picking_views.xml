<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_inherit_import_case" model="ir.ui.view">
        <field name="name">stock.picking.import.case</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='product_id']" position="after">
                <field name="package_ids" widget="many2many_tags" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
