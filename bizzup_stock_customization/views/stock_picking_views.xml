<odoo>
    <record id="bizzup_stock_customization_inherit_view_picking_form" model="ir.ui.view">
        <field name="name">bizzup.stock.customization.inherit.view.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom_qty']"
                   position="after">
                <field name="real_demand"/>
            </xpath>
        </field>
    </record>
</odoo>