<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View for Discuss Channels -->
        <record id="view_mail_channel_tree" model="ir.ui.view">
            <field name="name">discuss.channel.tree</field>
            <field name="model">discuss.channel</field>
            <field name="arch" type="xml">
                <list string="Channels">
                    <field name="name"/>
                    <field name="channel_type"/>
                </list>
            </field>
        </record>

        <!-- Form View for Discuss Channels -->
        <record id="view_mail_channel_form" model="ir.ui.view">
            <field name="name">discuss.channel.form</field>
            <field name="model">discuss.channel</field>
            <field name="arch" type="xml">
                <form string="Channel">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="channel_type"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo> 