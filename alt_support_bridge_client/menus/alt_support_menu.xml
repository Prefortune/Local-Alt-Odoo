<odoo>
    <data>
        <!-- Action for Alt Support Config -->
        <record id="action_alt_support_config" model="ir.actions.act_window">
            <field name="name">Alt Support Settings</field>
            <field name="res_model">alt.support.config</field>
            <field name="view_mode">list,form</field>
            <field name="target">current</field>
        </record>

        <!-- Main Menu -->
        <menuitem id="menu_alt_support_root"
                  name="Alt Support"
                  sequence="100"/>

        <!-- Settings Menu -->
        <menuitem id="menu_alt_support_config"
                  name="Alt Support Settings"
                  parent="menu_alt_support_root"
                  action="action_alt_support_config"
                  sequence="10"/>
    </data>
</odoo> 