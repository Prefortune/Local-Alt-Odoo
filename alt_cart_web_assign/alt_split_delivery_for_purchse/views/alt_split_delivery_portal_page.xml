<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="split_delivery_pag_olddd" name="Split Delivery Page">
    <t t-call="website.layout">
        <div class="container">
            <h2>Split Delivery for Order: <t t-esc="order.name"/></h2>
            <form class="split-delivery-form" t-att-action="'/my/orders/%s/split_delivery/save' % order.id" method="post">
                <input type="hidden" name="count" t-att-value="order.alt_split_delivery_count"/>
                <input type="hidden" name="order_id" t-att-value="order.id" />
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <t t-set="filtered_lines" t-value="order.order_line.filtered(lambda l: l.product_id.type != 'service')"/>
                <t t-foreach="range(order.alt_split_delivery_count)" t-as="i">
                
                    <div class="row mb-4 border p-3 rounded bg-light">
                        <div class="col-md-4">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="filtered_lines" t-as="line">
                                        <tr>
                                            <td>
                                                <input type="text" class="form-control" readonly="readonly"
                                                    t-attf-name="product_name_#{i}_#{line_index}"
                                                    t-att-value="line.name"/>
                                            </td>
                                            <td>
                                                <input type="number" class="form-control"
                                                    t-attf-name="quantity_#{i}_#{line_index}"
                                                    required="required"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div class="col-md-8">
                            <div class="form-group mb-3">
                                <label>Select Existing Address</label>
                                <select t-attf-name="partner_id_#{i}" class="form-control address-selector" t-attf-data-index="#{i}">
                                    <option value="">-- Create New Address --</option>
                                    <t t-foreach="order.partner_id.child_ids" t-as="addr">
                                        <option t-att-value="addr.id"
                                                t-att-data-street="addr.street or ''"
                                                t-att-data-street2="addr.street2 or ''"
                                                t-att-data-city="addr.city or ''"
                                                t-att-data-zip="addr.zip or ''"
                                                t-att-data-country="addr.country_id.name or ''">
                                            <t t-esc="addr.display_name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label>Street</label>
                                    <input type="text" t-attf-name="street_#{i}" class="form-control"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label>Street 2</label>
                                    <input type="text" t-attf-name="street2_#{i}" class="form-control"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label>City</label>
                                    <input type="text" t-attf-name="city_#{i}" class="form-control"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label>ZIP</label>
                                    <input type="text" t-attf-name="zip_#{i}" class="form-control"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label>Country</label>
                                    <select t-attf-name="country_id_#{i}" class="form-control">
                                        <t t-foreach="countries" t-as="country">
                                            <option t-att-value="country.id" t-att-data-name="country.name">
                                                <t t-esc="country.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary">Save Delivery Addresses</button>
                </div>
            </form>
        </div>

    </t>
</template>

<template id="split_delivery_page" name="Split Delivery Page">
    <t t-call="website.layout">
        <div class="container">
            <h2>Split Delivery for Order: <t t-esc="order.name"/></h2>
            <form class="split-delivery-form" t-att-action="'/my/orders/%s/split_delivery/save' % order.id" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="count" t-att-value="order.alt_split_delivery_count"/>

                <t t-set="filtered_lines" t-value="order.order_line.filtered(lambda l: l.product_id and l.product_id.type != 'service')"/>

                <t t-foreach="range(order.alt_split_delivery_count)" t-as="i">
                    <t t-set="delivery" t-value="delivery_data.get(i)"/>

                    <!-- Hidden delivery ID -->
                    <t t-if="delivery and delivery.get('picking_id')">
                        <input type="hidden" t-attf-name="picking_id_#{i}" t-att-value="delivery['picking_id']"/>
                    </t>

                    <div class="row mb-4 border p-3 rounded bg-light">
                        <t t-if="delivery and delivery['is_done']">
                            <div class="alert alert-warning">This delivery is Done and cannot be edited.</div>
                            <input type="hidden"
                                    t-attf-name="picking_status_#{i}"
                                    value="done"/>
                        </t>

                        <!-- Product Table -->
                        <div class="col-md-4">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="filtered_lines" t-as="line">
                                        <t t-set="move" t-value="delivery and delivery['moves'].get(line.id)"/>
                                        <tr>
                                            <td>
                                                <input type="text" class="form-control" readonly="readonly"
                                                       t-attf-name="product_name_#{i}_#{line.id}"
                                                       t-att-value="line.name"/>
                                                <input type="hidden"
                                                       t-attf-name="order_line_id_#{i}_#{line.id}"
                                                       t-att-value="line.id"/>
                                                <t t-if="move and move.get('move_id')">
                                                    <input type="hidden"
                                                           t-attf-name="move_id_#{i}_#{line.id}"
                                                           t-att-value="move['move_id']"/>
                                                </t>
                                            </td>
                                            <td>
                                                <input type="number" class="form-control"
                                                       t-attf-name="quantity_#{i}_#{line.id}"
                                                       t-att="{
                                                           'value': move['quantity'] if move else '',
                                                           'readonly': 'readonly' if delivery and delivery['is_done'] else None
                                                       }"
                                                       required="required"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- Address Fields -->
                        <div class="col-md-8">
                            <div class="form-group mb-3">
                                <label>Select Existing Address</label>
                                <t t-set="main_partner" t-value="order.partner_id.parent_id or order.partner_id"/>
                                <select t-attf-name="partner_id_#{i}" class="form-control address-selector"
                                        t-attf-data-index="#{i}"
                                        t-att-disabled="delivery and delivery['is_done'] and 'disabled'">
                                    <option value="">-- Create New Address --</option>
                                    <t t-foreach="main_partner.child_ids" t-as="addr">
                                        <option t-att-value="addr.id"
                                                t-att-selected="delivery and delivery['partner_id'] == addr.id"
                                                t-att-data-street="addr.street or ''"
                                                t-att-data-street2="addr.street2 or ''"
                                                t-att-data-city="addr.city or ''"
                                                t-att-data-zip="addr.zip or ''"
                                                t-att-data-country="addr.country_id.name or ''">
                                            <t t-esc="addr.display_name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label>Street</label>
                                    <input type="text" t-attf-name="street_#{i}" class="form-control"
                                           required="required"
                                           t-att="{
                                               'value': delivery and delivery.get('street', ''),
                                               'readonly': 'readonly' if delivery and delivery['is_done'] else None
                                           }"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label>Street 2</label>
                                    <input type="text" t-attf-name="street2_#{i}" class="form-control"
                                           t-att="{
                                               'value': delivery and delivery.get('street2', ''),
                                               'readonly': 'readonly' if delivery and delivery['is_done'] else None
                                           }"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label>City</label>
                                    <input type="text" t-attf-name="city_#{i}" class="form-control"
                                           t-att="{
                                               'value': delivery and delivery.get('city', ''),
                                               'readonly': 'readonly' if delivery and delivery['is_done'] else None
                                           }"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label>ZIP</label>
                                    <input type="text" t-attf-name="zip_#{i}" class="form-control"
                                           t-att="{
                                               'value': delivery and delivery.get('zip', ''),
                                               'readonly': 'readonly' if delivery and delivery['is_done'] else None
                                           }"/>
                                </div>
                                <!-- <div class="col-md-6 mb-2">
                                    <label>Country</label>
                                    <select t-attf-name="country_id_#{i}" class="form-control"
                                            required="required"
                                            t-att-disabled="delivery and delivery['is_done'] and 'disabled'">
                                        <t t-foreach="countries" t-as="country">
                                            <option t-att-value="country.id"
                                                    t-att-selected="delivery and delivery['country_id'] == country.id">
                                                <t t-esc="country.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div> -->
                            </div>
                        </div>
                    </div>
                </t>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary">Save Delivery Addresses</button>
                </div>
            </form>
        </div>
    </t>
</template>

    <template id="split_delivery_error_page" name="Split Delivery Error Page">
        <t t-call="website.layout">
            <div class="container my-5">
                <h2 class="text-danger">🚫 Delivery Assignment Error</h2>
                <p>Please fix the following issues:</p>
                <ul class="list-group">
                    <t t-foreach="error_messages" t-as="err">
                        <li class="list-group-item list-group-item-warning">
                            <t t-esc="err" />
                        </li>
                    </t>
                </ul>

                <div class="mt-4">
                    <a t-attf-href="/my/orders/{{ order }}/split_delivery" class="btn btn-primary">
                        🔁 Go Back to Split Delivery Form 
                        <!-- <t t-esc="order" /> -->
                    </a>
                </div>
            </div>
        </t>
    </template>

</odoo>