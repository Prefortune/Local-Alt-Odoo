<odoo>
    <record id="view_import_image_result_wizard_form" model="ir.ui.view">
        <field name="name">import.image.result.wizard.form</field>
        <field name="model">import.image.result.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Image Results">
                <group>
                    <field name="updated_product_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <group>
                    <field name="unmatched_filenames" readonly="1"/>
                </group>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
