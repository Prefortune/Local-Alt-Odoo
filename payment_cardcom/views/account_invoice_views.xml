<odoo>
    <data>
        <record id="payment_cardcom_account_move_form_inherit" model="ir.ui.view">
            <field name="name">payment.cardcom.account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='narration']" position="before">
                    <field name="transaction_id" readonly="1"/>
                    <field name="document_num" readonly="1" invisible="move_type == 'out_refund'"/>
                    <field name="document_url"  widget="url" readonly="1" invisible="move_type == 'out_refund'"/>
                    <!-- <field name="refund_document_url"  widget="url" invisible="move_type != 'out_refund'"/> -->
                    <field name="is_refund_button" invisible="1"/>
                    <!-- <field name="document_num"/> -->
                </xpath>
                <xpath expr="//button[@name='button_draft']" position="after">
                    <button name="action_refund_cardcom_payment" string="Refund CardCom" type="object" class="btn btn-primary" invisible="not is_refund_button or move_type != 'out_refund' or state != 'posted' or not transaction_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
