<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cardcom_redirect_form">
        <!-- <form action="https://secure.cardcom.solutions/External/lowProfileClearing/1000.aspx?LowProfileCode=2912a6c9-af19-40c7-9c76-24a6adeeda4b" method="post"> -->
        <form action="/cardcom/payment/process" method="post">
            <input name="redirect_url" t-att-value="redirect_url"/>
        </form>
        <h1></h1>
    </template>
    <template id="cardcom_iframe_form">
        <t t-call="website.layout">
            <div class="container">
                <iframe t-att-src="iframe_url"  width="100%" height="1000px" frameborder="0" ></iframe>
            </div>
        </t>
    </template>
    <!-- <template id="cardcom_failure">
        <t t-call="website.layout">
            <p>Payment Failed</p>
        </t>
    </template> -->

    <template id="cardcom_failure">
        <t t-call="website.layout">
            <section class="container my-5 text-center">
                <img src="/web/binary/company_logo" alt="לוגו ג'רמי גורמה" class="img-fluid mb-4" style="max-width: 150px;" />
                <h1 class="display-4 text-danger">התשלום לא הצליח</h1>
                <p class="lead mt-3">
                    לצערנו, לא הצלחנו לעבד את התשלום.
                </p>
                <p class="text-muted">
                    ייתכן ומדובר בתקלה זמנית, או בפרטי תשלום שגויים.
                    כדאי לבדוק שוב או לנסות כרטיס אחר.
                </p>
                <div class="mt-4 d-flex justify-content-center flex-wrap gap-2">
                    <a href="/shop" class="btn btn-primary">
                    חזרה לחנות
                </a>
                    <a href="/contactus" class="btn btn-outline-primary">
                    צרו קשר עם שירות לקוחות
                </a>
                </div>
                <p class="fw-bold mt-4">
                אנחנו כאן לכל שאלה.
            </p>
            </section>
        </t>
    </template>
    <!-- <template id="cardcom_success">
        <t t-call="website.layout">
            <p>Payment Successful</p>
        </t>
    </template> -->
    <template id="cardcom_success">
        <t t-call="website.layout">
            <t t-set="order_id" t-value="request.params.get('order_id')"/>
            <section class="container my-5 text-center">
                <img src="/web/binary/company_logo" alt="לוגו ג'רמי גורמה" class="img-fluid mb-4" style="max-width: 150px;" />
                <h1 class="display-4 text-primary">התשלום התקבל בהצלחה</h1>
                <p class="lead mt-3">
                    תודה שבחרת בג'רמי גורמה – עולם של טעמים בלתי נשכחים.
                 </p>
                <p class="text-muted">
                     ההזמנה שלך התקבלה ומטופלת כעת. אישור נשלח אליך למייל.
                </p>
                <div class="mt-4 d-flex justify-content-center flex-wrap gap-2">
                    <a href="/shop" class="btn btn-primary">
                    חזרה לחנות
                </a>
                    <a href="/contactus" class="btn btn-outline-primary">
                    שאלות? צרו קשר
                </a>
                </div>
            </section>
        </t>
    </template>
</odoo>