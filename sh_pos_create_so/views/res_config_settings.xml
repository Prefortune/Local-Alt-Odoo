<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sh_pos_create_so_view_form" model="ir.ui.view">
        <field name="name">sh_pos_create_so.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="pos_interface_section" position="after">
                <block title="Create Sale Order">
                    <setting string="Enable Sale Order">
                        <field name="pos_sh_display_sale_btn" />
                    </setting>
                    <setting string="Select Order State" invisible="not pos_sh_display_sale_btn">
                        <field name="pos_select_order_state" invisible="not pos_sh_display_sale_btn" widget="radio" />
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
