<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tranzila Redirect form view-->
    <template id="redirect_form">
        <form t-att-action="api_url" method="post">
            <input type="hidden" name="success_url_address" t-att-value="return_url"/>
            <input type="hidden" name="fail_url_address" t-att-value="return_url"/>
            <input type="hidden" name="notify_url_address" t-att-value="return_url"/>
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="reference" t-att-value="reference"/>
        </form>
    </template>
    <!-- Inherited Payment Acquirer for Tranzila-->
    <record id="payment_provider_form_inherit" model="ir.ui.view">
        <field name="name">Tranzila Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group invisible="code != 'tranzila'">
                    <field name="supplier" required="code == 'tranzila' and state != 'disabled'"/>
                    <field name="TranzilaPW" required="code == 'tranzila' and state != 'disabled'" password="True"/>
                </group>
            </xpath>

            <xpath expr="//page[@name='credentials']" position="after">
                <page name="provider_token_credentials" string="Tranzila Token Credentials"
                      invisible="allow_tokenization == False and code != 'tranzila'">
                    <group invisible="code != 'tranzila'">
                        <field name="token_supplier" required="allow_tokenization != False and code == 'tranzila' and state != 'disabled'"/>
                        <field name="token_tranzilaPW" required="allow_tokenization != False and code == 'tranzila' and state != 'disabled'" password="True"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
