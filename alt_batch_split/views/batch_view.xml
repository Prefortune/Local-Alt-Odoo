<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_create_wizards" model="ir.ui.view">
        <field name="name">batch.create.wizard.form</field>
        <field name="model">batch.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Batch">
                <header>
                    <button name="sec_stage_view" type="object" string="Add New Batch" class="btn-primary" invisible="stage != 'first' " />
                    <!-- <field name="delivery_stage" widget="statusbar" ></field> -->
                </header>
                <sheet>

                  <!-- This is for both Stage -->
                  <div class="oe_title">
                      <h1>
                          <field name="sale_order_id" readonly="1"/>
                      </h1>
                  </div>

                  <div class="alert alert-primary mt-4" invisible="stage == 'secound' ">
                            <strong>Order Lines:</strong>
                  </div>

                  <field name="show_sale_order_line_id" nolabel="1" invisible="stage == 'secound' ">
                        <list readonly="1">
                            <field name="product_id"/>
                            <field name="product_uom_qty"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal"/>
                        </list>
                 </field>

                  <!-- <button name="action_view_batches" type="object" string="List Of Batch" /> -->

                  <!-- this is for first stage -->
                  <div class="alert alert-primary mt-4" invisible="stage == 'secound' ">
                            <strong>Delivery Batches:</strong>
                  </div>
                  
                  <!-- <field name="batch_ids" invisible="stage == 'secound'">
                        <list create="false" editable="bottom">
                            <field name="name"></field>
                            <button name="action_open_batch"
                                type="object"
                                icon="fa-external-link"
                                string="Open" />
                        </list>
                  </field> -->

                  <field name="batch_ids" invisible="stage == 'secound'">
                        <list create="false" delete="false">
                            <field name="name" required="1"></field>
                            <field name="deadline_date" required="1"></field>
                            <field name="note"></field>

                            <!-- <field name="delivery_stage" 
                                   widget="badge" 
                                   decoration-danger="delivery_stage == 'cancel'"
                                   decoration-info="delivery_stage == 'draft'"
                                   decoration-success="delivery_stage == 'done'"
                                   
                            ></field> -->
                        </list>
                  </field>

                     


                  <!-- this is for sec stage -->
                  <group name="name" string="Order" invisible="stage == 'first' ">
                    <field name="name" invisible="stage == 'first' "/>
                    <field name="deadline_date" invisible="stage == 'first' "></field>
                    <field name="note" invisible="stage == 'first' "></field>
                  </group>
                  <div class="alert alert-warning mt-4" invisible="stage == 'first' ">
                            <strong>Sale Order Lines:</strong>
                  </div>
                  <field name="sale_order_line_ids" invisible="stage == 'first'">
                      <list editable="bottom">
                          <field name="product_id"/>
                          <field name="quantity"/>
                      </list>
                  </field>

                </sheet>
                <footer>
                    <button string="Save This Batch And Create Deliverys" type="object" name="save_this_batch_to_delivery" invisible="stage == 'secound' " class="btn-secondary"/>
                    <button string="Save This Batch" type="object" name="save_this_batch_in_lines" invisible="stage == 'first' " class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="batch_create_wizard_actions" model="ir.actions.act_window">
        <field name="name">Create Batch</field>
        <field name="res_model">batch.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'sale_order_id': active_id}</field>
    </record>
</odoo>
