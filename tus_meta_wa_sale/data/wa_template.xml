<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <record id="sales_wa_template" model="wa.template">
            <field name="name">sale_template</field>
            <field name="provider_id" ref="tus_meta_whatsapp_base.provider_1" />
            <field name="model_id" ref="sale.model_sale_order" />
            <field name="category">utility</field>
            <field name="template_type">template</field>
            <field name="language">en</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <div style="margin: 0px; padding: 0px;">
                        <p style="margin: 0px; padding: 0px; font-size: 13px;">
                            Hello <t t-out="object.partner_id.name or 'Customer'" />,
                            <br /><br />
                            Your quotation <strong
                                t-out="object.name or ''"
                                contenteditable="false"
                            >S0001</strong> amounting in <strong
                                t-out="format_amount(object.amount_total, object.pricelist_id.currency_id) or ''"
                                contenteditable="false"
                            >$ 10.00</strong> is ready for review.
                            <br /><br />
                            Do not hesitate to contact us if you have any questions.
                            <br />
                        </p>
                    </div>
                </div>
            </field>
        </record>

        <record id="sales_wa_template_header" model="components">
            <field name="type">header</field>
            <field name="formate">media</field>
            <field name="wa_template_id" ref="tus_meta_wa_sale.sales_wa_template" />
            <field name="media_type">document</field>
        </record>

        <record id="sales_wa_template_body" model="components">
            <field name="type">body</field>
            <field name="formate">text</field>
            <field name="wa_template_id" ref="tus_meta_wa_sale.sales_wa_template" />
            <field name="text">Hello {{1}},

Your quotation {{2}} amounting in {{3}} is ready for review.

Do not hesitate to contact us if you have any questions.</field>
        </record>
    </data>
</odoo>
