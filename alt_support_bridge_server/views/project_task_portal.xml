<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="alt_support_bridge_server_portal_my_task" name="My Task" inherit_id="project.portal_my_task">
        <xpath expr="//div[@id='card_header']" position="replace">
            <div id="card_header" data-anchor="true">
                <div class="row justify-content-between mb-3">
                    <div class="col-12 col-md-9">
                        <div class="d-flex gap-2">
                            <h3 class="my-0">
                                <t t-call="project.portal_my_tasks_priority_widget_template"/>
                                <span t-field="task.name"/>
                                <small class="text-muted d-none d-md-inline">(#                                    <span t-field="task.id"/>
)</small>
                            </h3>
                        </div>
                    </div>
                    <!-- <div class="col-auto">
                        <small class="text-end">Stage:</small>
                        <span t-field="task.stage_id.name" class=" badge rounded-pill text-bg-info" title="Current stage of this task"/>
                    </div> -->
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@t-if='task.user_ids']" position="replace">
            <div t-if="task.user_ids">
                <!-- <h6 class="flex-basis-100">
                    <small class="text-muted">Assignees</small>
                </h6>
                <t t-foreach="task.user_ids" t-as="user">
                    <t t-call="portal.portal_my_contact">
                        <t t-set="_spacingClass" t-value="'mb-3' if len(task.user_ids) > 1 else ''"/>
                        <t t-set="_contactAvatar" t-value="image_data_uri(user.avatar_128)"/>
                        <t t-set="_contactName" t-value="user.name"/>
                        <div t-out="user" t-options='{"widget": "contact", "fields": ["email", "phone"]}'/>
                    </t>
                </t> -->
            </div>
        </xpath>
        <xpath expr="//div[@id='task_content']/div[@id='card']" position="after">
            <t t-set="alt_change_request_ids" t-value="task.change_request_ids"/>
            <t t-if="alt_change_request_ids">
                <h5 id="task_change_request" class="mt-2 mb-2" data-anchor="true">Task Change Request</h5>
                <table class="o_portal_my_doc_table table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Created By</th>
                            <th>Note</th>
                            <th>Status</th>
                            <th class="text-end" name="t_label">Allocated Time (Hours)</th>
                            <th class="text-end" name="t_label">Action</th>
                        </tr>
                    </thead>
                    <tr t-foreach="alt_change_request_ids" t-as="changes" valign="middle">

                        <td>
                            <t t-esc="changes.partner_id.name"/>
                        </td>
                        <td>
                            <t t-esc="changes.note"/>
                        </td>
                        <td>
                            <t t-esc="changes.state"/>
                        </td>
                        <td class="text-end">
                            <t t-esc="changes.time" t-options='{"widget": "float_time"}'/>
                        </td>
                        <td class="text-end">
                            <t t-if="changes.state == 'Pending'">
                                <a t-attf-href="/task/change/request/{{changes.id}}/confirm" type="button" class="btn btn-success">
                                    <span>
                                                            Confirm
                                    </span>
                                </a>
                                <a t-attf-href="/task/change/request/{{changes.id}}/reject" type="button" class="btn btn-danger">
                                    <span>
                                                            Reject
                                    </span>
                                </a>
                            </t>
                        </td>
                    </tr>
                </table>
            </t>
        </xpath>
    </template>

    <template id="alt_support_portal_my_home" name="Projects / Tasks" inherit_id="project.portal_my_home">
        <xpath expr="//div[@id='portal_service_category']" position="replace">
            <div id="portal_service_category" position="inside">
                <!-- <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/web/static/img/folder.svg'"/>
                    <t t-set="title">Projects</t>
                    <t t-set="url" t-value="'/my/projects'"/>
                    <t t-set="text">Follow the evolution of your projects</t>
                    <t t-set="placeholder_count" t-value="'project_count'"/>
                </t> -->
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/project/static/src/img/tasks.svg'"/>
                    <t t-set="title">Tasks</t>
                    <t t-set="url" t-value="'/my/tasks'"/>
                    <t t-set="text">Follow and comments tasks of your projects</t>
                    <t t-set="placeholder_count" t-value="'task_count'"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="alt_support_portal_my_tasks_state_widget_template" name="Status Widget Template" inherit_id="project.portal_my_tasks_state_widget_template">
        <xpath expr="." position="replace">
            <span t-att-title="dict(task.fields_get(allfields=['state'])['state']['selection'])[task.state]">
                <i t-attf-class="
            fa 
            #{ 
                'fa-check-circle text-success' if task.state == '00_new_state' else
                'fa-spinner fa-spin text-primary' if task.state == '01_in_progress' else
                'fa-exclamation-triangle text-warning' if task.state == '02_changes_requested' else
                'fa-thumbs-up text-success' if task.state == '03_approved' else
                'fa-check-circle text-success' if task.state == '1_done' else
                'fa-times-circle text-danger' if task.state == '1_canceled' else
                'fa-hourglass-o text-info' if task.state == '04_waiting_normal' else
                'fa-flag-checkered text-success' if task.state == '05_finished' else
                ''
            }
        "/>
                <span class="ml-1" t-esc="dict(task.fields_get(allfields=['state'])['state']['selection'])[task.state]"/>
            </span>
        </xpath>
    </template>

