<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View for API Tokens -->
        <record id="view_alt_support_token_tree" model="ir.ui.view">
            <field name="name">alt.support.token.tree</field>
            <field name="model">alt.support.token</field>
            <field name="arch" type="xml">
                <list string="API Tokens">
                    <field name="name"/>
                    <field name="token"/>
                    <field name="server_token"/>
                    <field name="url"/>
                    <field name="active"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <!-- Form View for API Tokens -->
        <record id="view_alt_support_token_form" model="ir.ui.view">
            <field name="name">alt.support.token.form</field>
            <field name="model">alt.support.token</field>
            <field name="arch" type="xml">
                <form string="API Token">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="token"/>
                            <field name="server_token"/>
                            <field name="url"/>
                            <field name="active"/>
                        </group>
                        <div class="alert alert-info" role="alert">
                            <strong>עזרה:</strong><br/>
                            <strong>Client Token:</strong> טוקן זה משמש את הלקוח לאימות מול השרת<br/>
                            <strong>Server Token:</strong> טוקן זה משמש את השרת לאימות מול הלקוח. יש להעתיק אותו לקונפיגורציה של הלקוח
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for API Tokens -->
        <record id="action_alt_support_token" model="ir.actions.act_window">
            <field name="name">API Tokens</field>
            <field name="res_model">alt.support.token</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo> 