<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_task_form_view_form_inherit_alt" model="ir.ui.view">
            <field name="name">project.task.form.view.form.alt</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='extra_info']" position="after">
                    <page string="Change Request" name="change_request">
                        <group>
                            <field name="change_request_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="partner_id" readonly="1"></field>
                                    <field name="note"></field>
                                    <field name="state" readonly="1"></field>
                                    <field name="time" widget="float_time"></field>
                                </list>
                            </field>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//field[@name='tag_ids']" position="after">
                    <field name="alt_subscription_id"></field>
                </xpath>
            </field>
        </record>
    </data>
</odoo> 