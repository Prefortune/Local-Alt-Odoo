<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_create_wizard_form" model="ir.ui.view">
        <field name="name">project.task.create.wizard.form</field>
        <field name="model">project.task.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Project Task">
                <group>
                    <field name="project_id" invisible="1"/>
                    <field name="name"/>
                    <field name="alt_subscription_id" readonly="1"/>
                    <field name="customer_id"/>
                    <field name="user_id"/>
                    <field name="allocated_hours" widget="float_time"/>
                    <field name="date_deadline"/>
                    <field name="description" type="html" options="{'collaborative': true, 'resizable': false}" placeholder="Add details about this task..."/>
                </group>
                <footer>
                    <button string="Create Task"
                            type="object"
                            name="action_create_task"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_task_create_wizard" model="ir.actions.act_window">
        <field name="name">Create Task</field>
        <field name="res_model">project.task.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_project_task_create_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
