<odoo>

<record id="view_res_config_settings_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='languages']" position="after">
                <h2>Shopify Inquiry Configuration</h2>
                <div class="row mt16 o_settings_container" name="shopify_inquiry_container">
                 <group>
                    <group name="shopify_inquiry" string="shopify inquiry">
                        <field name="helpdesk_id" widget="many2one" options="{'no_create': True}" class="o_form_field"/>
                        <field name="ticket_type_id" widget="many2one" options="{'no_create': True}" class="o_form_field"/>
                        <field name="tag_id" widget="many2one" options="{'no_create': True}" class="o_form_field"/>
                    </group>
                    <!-- <group name="Set Email Cron" string="Set Email Cron">
