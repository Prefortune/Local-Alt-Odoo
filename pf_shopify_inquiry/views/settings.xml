                        <field name="stop_after" attrs="{'readonly' : [('is_create_cron','==',False)]}"/>
                        <field name="state" attrs="{'readonly' : [('is_create_cron','==',False)]}" widget="badge" decoration-muted="state == 'create'" decoration-danger="state == 'cancel'" decoration-success="state == 'complete'" decoration-info="state == 'running'"/>
                    </group> -->
                </group>
                <!-- <div class="d-grid gap-2 d-md-flex justify-content-md-end">
